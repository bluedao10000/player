[Unit]
Description=Folio episode scheduler (%i)
After=network-online.target docker.service
Wants=network-online.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/folio-data
EnvironmentFile=/home/ubuntu/folio-data/database.env
EnvironmentFile=-/home/ubuntu/folio-data/lane.env
Environment=KNOWLEDGE_RESEARCH_URL=http://127.0.0.1:4312
Environment=KNOWLEDGE_ARCHIVE_DIR=/home/ubuntu/folio-data/archive
Environment=EPISODE_PLAN_DIR=/home/ubuntu/folio-data/plans
ExecStart=/home/ubuntu/folio-data/bin/knowledge-sync -episode-lane=%i
Restart=always
RestartSec=10
NoNewPrivileges=true
BindReadOnlyPaths=/home/ubuntu/folio-data/art:/reader-art
BindReadOnlyPaths=/home/ubuntu/folio-data/media:/media
[Install]
WantedBy=multi-user.target
