# Only this enrolled /32 can enter the three read surfaces.
resolver 127.0.0.11 valid=10s ipv6=off;
upstream gz_reader_api { zone gz_reader_api 64k; server reader-api:4310 resolve; keepalive 16; }
upstream gz_api { zone gz_api 64k; server api:4311 resolve; keepalive 16; }
upstream gz_image { zone gz_image 64k; server image:14580 resolve; keepalive 16; }
server {
    listen ${GZ_MESH_IP}:${MESH_READER_API_PORT};
    allow ${ALI_MESH_IP}/32;
    deny all;
    access_log off;
    location ~* ^/(workbench|editor-api|editor-preview|admin|v1(?:/|$)) { return 404; }
    location / {
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $http_x_forwarded_for;
        proxy_set_header Forwarded "";
        proxy_set_header Connection "";
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_read_timeout 90s;
        proxy_next_upstream off;
        proxy_pass http://gz_reader_api;
    }
}
server {
    listen ${GZ_MESH_IP}:${MESH_API_PORT};
    allow ${ALI_MESH_IP}/32;
    deny all;
    access_log off;
    location ~ "^/api/v1/knowledge/(discovery|works(/[0-9a-fA-F-]{36})?|worlds(/[a-z0-9-]+(/(characters|chapters|scenes)/[a-z0-9-]+)?)?)$" {
        limit_except GET { deny all; }
        proxy_next_upstream off;
        proxy_pass http://gz_api;
    }
    location / { return 404; }
}
server {
    listen ${GZ_MESH_IP}:${MESH_IMAGE_PORT};
    allow ${ALI_MESH_IP}/32;
    deny all;
    access_log off;
    location ~ ^/(i/|readyz$) {
        limit_except GET { deny all; }
        proxy_buffering off;
        proxy_next_upstream off;
        proxy_pass http://gz_image;
    }
    location / { return 404; }
}
