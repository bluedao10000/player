# Only this enrolled /32 can enter the three read surfaces.
map $http_upgrade $reader_connection { default ""; ~*^websocket$ upgrade; }
resolver 127.0.0.11 valid=10s ipv6=off;
upstream gz_web { zone gz_web 64k; server web:4310 resolve; keepalive 16; }
upstream gz_api { zone gz_api 64k; server api:4311 resolve; keepalive 16; }
upstream gz_image { zone gz_image 64k; server image:14580 resolve; keepalive 16; }
server {
    listen ${GZ_MESH_IP}:${MESH_WEB_PORT};
    allow ${ALI_MESH_IP}/32;
    deny all;
    access_log off;
    location ~* ^/(workbench|editor-api|editor-preview|admin|v1(?:/|$)) { return 404; }
    location / {
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $reader_connection;
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_read_timeout 90s;
        proxy_next_upstream off;
        proxy_pass http://gz_web;
    }
}
server {
    listen ${GZ_MESH_IP}:${MESH_API_PORT};
    allow ${ALI_MESH_IP}/32;
    deny all;
    access_log off;
    location ~ ^/api/v1/knowledge/(discovery|worlds(/[a-z0-9-]+(/(characters|chapters|scenes)/[a-z0-9-]+)?)?)$ {
        limit_except GET { deny all; }
        proxy_next_upstream off;
        proxy_pass http://gz_api;
    }
    location / { return 404; }
}
server {
    listen ${GZ_MESH_IP}:${MESH_IMAGE_PORT};
    allow ${ALI_MESH_IP}/32;
    deny all;
    access_log off;
    location ~ ^/(i/|art/|image-preview/art/) {
        limit_except GET { deny all; }
        proxy_buffering off;
        proxy_next_upstream off;
        proxy_pass http://gz_image;
    }
    location / { return 404; }
}
