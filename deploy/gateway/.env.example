PUBLIC_HOST=www.codeiy.com
ACCOUNT_HOST=r.codeiy.com
# Set each endpoint from the deployed private network or a Unix socket visible to Nginx.
API_UPSTREAM=
READER_API_UPSTREAM=
IMAGE_UPSTREAM=
IMAGE_UPSTREAM_SCHEME=http
IMAGE_UPSTREAM_HOST=
# Mount a full chain and key covering PUBLIC_HOST and img.codeiy.com as fullchain.pem and privkey.pem.
EDGE_TLS_DIR=
# Absolute host directories used by Docker Compose.
EDGE_CONFIG_DIR=
EDGE_RELAY_DIR=
EDGE_BIND=0.0.0.0
EDGE_HTTP_PORT=80
EDGE_HTTPS_PORT=443
# Standalone Nginx also requires NGINX_WORKER_USER, TLS_FULLCHAIN and TLS_PRIVATE_KEY.
# Set SITE_ROOT, IMAGE_CACHE_DIR and UPSTREAM_CA_BUNDLE when they differ from the defaults.
# For a local Cloudflare Tunnel with a verified HTTPS origin, set this to 1.
# Set both HTTP_LISTEN and HTTPS_LISTEN to reviewed 127.0.0.1 ports and use host networking.
# CLOUDFLARE_LOCAL_TUNNEL=1
