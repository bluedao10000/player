# Docker Compose 与本地开发共用。首次启动前将密码设为随机值。
POSTGRES_PASSWORD=
KNOWLEDGE_PG_PORT=5434
KNOWLEDGE_API_PORT=4321
PGUSER=anime
PGDATABASE=anime_knowledge
PGHOST=127.0.0.1
PGPORT=${KNOWLEDGE_PG_PORT}
PGPASSWORD=${POSTGRES_PASSWORD}
DATABASE_URL=postgresql:///?sslmode=disable
KNOWLEDGE_API_URL=http://127.0.0.1:${KNOWLEDGE_API_PORT}
# 私有部署可选，提升公开 GitHub release metadata 的查询配额。
# KNOWLEDGE_GITHUB_TOKEN=
WEB_PORT=4310
API_PORT=4311
AGENT_PORT=4312
# Operator status identity; use a unique node name on each sync deployment.
OPS_NODE_NAME=local
APP_VERSION=local
# AGENT_DB_PATH=/absolute/path/agent.sqlite
KNOWLEDGE_ARCHIVE_DIR=./.local/knowledge-archive
# KNOWLEDGE_ADMIN_TOKEN=
# KNOWLEDGE_ADMIN_OPERATOR=editor
# Optional knowledge content and image gateway; direct provider credentials remain independent.
# CONTENT_AI_MODE=magpie
# MAGPIE_CONTENT_MODEL=volcengine/kimi-k3.1-pro
# MEDIA_AI_MODE=magpie
# MAGPIE_IMAGE_MODEL=codex/gpt-image-2
# Original Tidepost media can use an independent gateway route.
# ORIGINAL_MEDIA_AI_MODE=magpie
# MAGPIE_ORIGINAL_IMAGE_MODEL=volcengine/doubao-seedream-5-0-pro
# MAGPIE_BASE_URL=https://your-gateway.example/v1
# MAGPIE_API_KEY=
# MAGPIE_ACCOUNT=studio-gateway
# Content: Pi research, writing and proofreading.
CONTENT_AI_BASE_URL=
CONTENT_AI_API_KEY=
CONTENT_AI_MODEL=gpt-4.1-mini
# responses (OpenAI) or chat-completions (e.g. DeepSeek with its own URL/key/model).
CONTENT_AI_PROTOCOL=responses
# Image generation and edits for the Pi media workflow.
MEDIA_AI_BASE_URL=https://api.openai.com/v1
MEDIA_AI_MODEL=gpt-image-2
MEDIA_AI_API_KEY=
MEDIA_WORKER_ENABLED=false
# Visual judgment: Responses-compatible endpoint with image input.
VISION_AI_BASE_URL=
VISION_AI_API_KEY=
VISION_AI_MODEL=gpt-4.1-mini
VISION_AI_SECOND_MODEL=gpt-4.1
# Work identity judgment (admin service). Select typesafe for Jev's /systemone.
MATCH_AI_PROVIDER=openai
MATCH_AI_BASE_URL=
MATCH_AI_MODEL=
MATCH_AI_API_KEY=
TYPESAFE_BASE_URL=https://api.typesafe.ai/v1
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
# Stable provider billing-account labels (never use a key as a label).
CONTENT_AI_ACCOUNT=default
MEDIA_AI_ACCOUNT=default
VISION_AI_ACCOUNT=default
MATCH_AI_ACCOUNT=default
TYPESAFE_ACCOUNT=default
# Existing installations can keep RESEARCH_OPENAI_API_KEY, RESEARCH_MODEL,
# MEDIA_REVIEW_MODEL and MEDIA_SECOND_REVIEW_MODEL during migration.

# 支付宝电脑网站支付（仅 Gin API 读取）。回调使用本项目域名。
# ALIPAY_APP_ID=
# ALIPAY_PUBLIC_KEY=
# ALIPAY_NOTIFY_URL=https://reader.example.org/api/billing/alipay/notify
# ALIPAY_PRIVATE_KEY=
# ALIPAY_SELLER_ID=

# 读者邮箱验证码（API 服务，使用已验证的 Resend 发件地址）
AUTH_RESEND_API_KEY=
AUTH_EMAIL_FROM=

# 微信开放平台网站应用（由 API 读取）
# WECHAT_APP_ID=
# WECHAT_APP_SECRET=
# WECHAT_CALLBACK_URL=https://reader.example.org/reader-auth/callback/wechat
# WECHAT_IOS_APP_ID=
# WECHAT_IOS_APP_SECRET=
