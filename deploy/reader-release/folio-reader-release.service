[Unit]
Description=Publish one accepted Folio episode and verify public readers
After=network-online.target
[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/folio-data
EnvironmentFile=/home/ubuntu/folio-data/database.env
Environment=KNOWLEDGE_ARCHIVE_DIR=/home/ubuntu/folio-data/archive
Environment=READER_SSH_CONFIG=/home/ubuntu/folio-data/publish/ssh_config
Environment=READER_PUBLIC_URL=https://www.codeiy.com
ExecStart=/home/ubuntu/folio-data/bin/reader-release send
NoNewPrivileges=true
PrivateTmp=true
