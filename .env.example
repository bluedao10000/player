# Docker Compose 与本地开发共用。首次启动前将密码设为随机值。
POSTGRES_PASSWORD=
KNOWLEDGE_PG_PORT=5434
KNOWLEDGE_API_PORT=4321
PGUSER=anime
PGDATABASE=anime_knowledge
PGHOST=127.0.0.1
PGPORT=${KNOWLEDGE_PG_PORT}
PGPASSWORD=${POSTGRES_PASSWORD}
DATABASE_URL=postgresql:///?sslmode=disable
KNOWLEDGE_API_URL=http://127.0.0.1:${KNOWLEDGE_API_PORT}
# 私有部署可选，提升公开 GitHub release metadata 的查询配额。
# KNOWLEDGE_GITHUB_TOKEN=
WEB_PORT=4310
API_PORT=4311
AGENT_PORT=4312
# AGENT_DB_PATH=/absolute/path/agent.sqlite
KNOWLEDGE_ARCHIVE_DIR=./data/knowledge-archive
# KNOWLEDGE_ADMIN_TOKEN=
# KNOWLEDGE_ADMIN_OPERATOR=editor
# Content: Pi research, writing and proofreading.
CONTENT_AI_BASE_URL=
CONTENT_AI_API_KEY=
CONTENT_AI_MODEL=gpt-4.1-mini
# responses (OpenAI) or chat-completions (e.g. DeepSeek with its own URL/key/model).
CONTENT_AI_PROTOCOL=responses
# Image generation and edits. Same profile for the independent art preview CLI.
MEDIA_AI_BASE_URL=https://api.openai.com/v1
MEDIA_AI_MODEL=gpt-image-2
MEDIA_AI_API_KEY=
MEDIA_WORKER_ENABLED=false
# Visual judgment: Responses-compatible endpoint with image input.
VISION_AI_BASE_URL=
VISION_AI_API_KEY=
VISION_AI_MODEL=gpt-4.1-mini
VISION_AI_SECOND_MODEL=gpt-4.1
# Work identity judgment (admin service). Select typesafe for Jev's /systemone.
MATCH_AI_PROVIDER=openai
MATCH_AI_BASE_URL=
MATCH_AI_MODEL=
MATCH_AI_API_KEY=
TYPESAFE_BASE_URL=https://api.typesafe.ai/v1
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
# Stable provider billing-account labels (never use a key as a label).
CONTENT_AI_ACCOUNT=default
MEDIA_AI_ACCOUNT=default
VISION_AI_ACCOUNT=default
MATCH_AI_ACCOUNT=default
TYPESAFE_ACCOUNT=default
# Existing installations can keep RESEARCH_OPENAI_API_KEY, RESEARCH_MODEL,
# MEDIA_REVIEW_MODEL and MEDIA_SECOND_REVIEW_MODEL during migration.
