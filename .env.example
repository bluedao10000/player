# Docker Compose 与本地开发共用。首次启动前将密码设为随机值。
POSTGRES_PASSWORD=
KNOWLEDGE_PG_PORT=5434
KNOWLEDGE_API_PORT=4321
PGUSER=anime
PGDATABASE=anime_knowledge
PGHOST=127.0.0.1
PGPORT=${KNOWLEDGE_PG_PORT}
PGPASSWORD=${POSTGRES_PASSWORD}
DATABASE_URL=postgresql:///?sslmode=disable
KNOWLEDGE_API_URL=http://127.0.0.1:${KNOWLEDGE_API_PORT}
# 私有部署可选，提升公开 GitHub release metadata 的查询配额。
# KNOWLEDGE_GITHUB_TOKEN=
WEB_PORT=4310
API_PORT=4311
AGENT_PORT=4312
# AGENT_DB_PATH=/absolute/path/agent.sqlite
KNOWLEDGE_ARCHIVE_DIR=./data/knowledge-archive
# KNOWLEDGE_ADMIN_TOKEN=
# KNOWLEDGE_ADMIN_OPERATOR=editor
# Optional, OpenAI-compatible base URL including /v1. Server-side only.
# Set MATCH_AI_PROVIDER=typesafe for Jev native typed judgments.
MATCH_AI_PROVIDER=openai
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
MATCH_AI_BASE_URL=
MATCH_AI_MODEL=
MATCH_AI_API_KEY=
# Independent original-art preview CLI provider.
MEDIA_AI_BASE_URL=
MEDIA_AI_MODEL=
MEDIA_AI_API_KEY=
