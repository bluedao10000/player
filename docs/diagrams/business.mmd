%% 潮汐邮局 · 知识库构建整体流程 · 2026-11-18
flowchart LR
  sync["同步与清洗<br/>按源探测 · 解析 · 归一化暂存<br/>〔已实现〕"]:::live
  clean["基础档案<br/>作品 UUID · 别名 · 来源版本<br/>〔已实现〕"]:::live
  sample["已有关联知识<br/>原创清单 / 站内清单与外部证据<br/>〔已实现〕"]:::live
  reader["已发布样板可读<br/>Gin → H5 · 章节与场景互链<br/>〔已实现〕"]:::live
  observe["定时质检与运行观测<br/>检查入库质量 · 查看同步结果<br/>〔已实现〕"]:::live
  select["运营选定构建范围<br/>指定版本、集章范围、必需图位<br/>〔待开发〕"]:::planned
  research["AI 联网研究与取证<br/>Pi 查权威资料 · 对齐清洗事实<br/>〔待开发〕"]:::planned
  draft["编写四类候选内容<br/>人物 · 剧情 · 世界观 · 时间线<br/>〔待开发〕"]:::planned
  pics["创建图位任务<br/>主视觉 · 角色立绘 · 场景图<br/>〔待开发〕"]:::planned
  checkpic["自动验图与优化<br/>来源 · 一致性 · 剧情 · 手机裁切<br/>〔待开发〕"]:::planned
  gate["五维通过 → 知识已验收<br/>覆盖范围 · 叙事质量 · 图位通过数<br/>〔待开发〕"]:::planned
  fix["待补证或返工<br/>补材料／重编／重裁后复验<br/>〔待开发〕"]:::planned
  publish["正式发布指定范围<br/>按范围切换版本 · 新集增量重验<br/>〔待开发〕"]:::planned
  sync --> clean
  clean --> sample
  sample --> reader
  sync --> observe
  clean -.->|选中| select
  select -.-> research
  research -.-> draft
  select -.-> pics
  pics -.-> checkpic
  checkpic -.-> gate
  draft -.-> gate
  gate -.->|通过| publish
  gate -.->|待补证或返工| fix
  fix -.->|复验| gate
  classDef live fill:#e5f0ea,stroke:#317167,color:#184e46
  classDef planned fill:#f5edf3,stroke:#986987,color:#78476a,stroke-dasharray:6 4
  classDef external fill:#f2eadb,stroke:#aa8954,color:#765929
  classDef area fill:#e5e9e6,stroke:#7a8b89,color:#425557
  classDef brand fill:#27454c,stroke:#27454c,color:#ffffff
