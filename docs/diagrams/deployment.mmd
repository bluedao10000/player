flowchart TB
    reader["H5 与 iOS"] -->|www · HTTPS| edge["Cloudflare Tunnel"]
    subgraph ali["阿里云杭州 · 100.96.0.3"]
      site["读者站与 Gin"] -->|查询| online[("线上 PostgreSQL 与入选图片")]
      receive["受限 SSH 接收端"] -->|校验摘要并提交定稿| online
    end
    edge --> site
    subgraph gz["腾讯云广州 · 100.96.0.1"]
      text["研究调度 · Pi 与 Kimi"] --> pg[("PostgreSQL 制作库")]
    end
    subgraph sv["腾讯云硅谷 · 100.96.0.2"]
      media["采集、媒体与五维验收"] -->|调用 Pi 和 OpenAI| archive["候选图与选图归档"]
