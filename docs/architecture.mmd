flowchart TB
  subgraph front["前端 · TanStack Router / SwiftUI"]
    readers["公开 H5 与 iOS"]
  end
  subgraph backend["后端 · Go"]
    api["Gin 阅读 API · 阿里云"]
    localsync["本地 sync · 同一生产流程"]
    sync["云端 sync · 广州规划与文本 / 硅谷媒体与验收"]
    publish["分集定稿投递 · 显式上线授权"]
  end
  subgraph agents["Agent · TypeScript"]
    pi["Pi Durable · 配置生成、研究与媒体"]
    state["SQLite · 执行检查点"]
    models["Magpie Kimi / OpenAI"]
  end
  pg[("制作 PostgreSQL · 配置、用量与回执")]
  local[("本地 PostgreSQL · 制作计划与验收")]
  online[("正式读库与入选图片")]
  media["广州 Axum + libvips · 图片库"]
  backup["K3s · 每日备份与恢复校验"]
  readers -->|公开 JSON| api
  api -->|读已发布内容| online
  localsync -->|校验登记与验收| local
  localsync -->|本地实例| pi
  sync -->|盘点、校验登记、五维验收| pg
  sync -->|内部 HTTP| pi
  pi --> state
  pi --> models
  pg -->|验收定稿与入选图| publish
  publish -->|Mesh 内网投递| online
  readers -->|img.codeiy.com 经 Nginx 与私网| media
  backup -->|Mesh 只读快照| pg
%% readers | H5 与 iOS 共享公开阅读契约和段落锚点。 | apps/ios/server/reader.server.ts
%% api | 在线 Gin 提供正式站公开读模型和读者业务。 | apps/api/internal/handler/knowledge/world_api.go
%% localsync | 本地 Compose 的 sync、数据库和 Pi 实例互相配合。 | deploy/docker-compose.yml
%% sync | 广州校验缺口并自动登记配置，硅谷执行媒体处理与五维验收。本地 Compose 运行同样的业务代码。 | apps/sync/internal/service/scheduler/production.go
%% publish | 仅投递有明确上线授权的定稿，接收端按指纹幂等。 | apps/sync/cmd/reader-release/main.go
%% pi | Pi 根据已登记来源模板生成分集配置，执行取证、写作、出图与验图。 | apps/agent/src/server.ts
%% state | Pi 保存恢复执行所需的检查点。 | deploy/docker-compose.yml
%% models | 文本走 Magpie Kimi，硅谷使用 OpenAI 图像和视觉模型。 | docs/模型用量与计费.md
%% pg | 广州制作库保存业务事实、配置快照、预算、五维验收和发布回执。 | database/migrations/init.sql
%% local | 本地数据库保存配置、制作记录和验收状态。 | database/migrations/init.sql
%% online | 阿里云在一个事务中安装单集投影并记录回执。 | apps/api/internal/repository/queries/release/queries.queries
%% media | 广州负责原件分发、签名与转换。 | apps/image/README.md
%% backup | 从同一源快照导出、恢复并逐表核对。 | deploy/pg-backup/backup.sh
