flowchart TB
  subgraph front["前端"]
    h5["H5 · TanStack Start SSR"]
    ios["iOS · SwiftUI"]
    bench["内部工作台"]
  end
  subgraph backend["后端 · Go"]
    api["阿里云 · Gin 阅读 API"]
    admin["内部 Gin · 工作台 API"]
    worker["数据服务 · 广州文本 / 硅谷采集与媒体"]
    publish["定稿导出、接收与公网校验"]
  end
  subgraph agents["Agent · TypeScript"]
    pi["Pi Durable · 研究、媒体与编辑"]
    state["SQLite 检查点"]
    models["模型直连与网关"]
  end
  pg[("制作 PostgreSQL 与归档")]
  online[("正式站读库与选图")]
  backup["K3s · 分日备份与恢复库"]
  h5 --> api
  ios -->|公开阅读 JSON| api
  bench --> admin
  admin -->|读任务、用量与回执| pg
  worker -->|采集、清洗、准入、五维验收| pg
  worker -->|内部 HTTP| pi
  pi --> state
  pi --> models
  pg -->|发布范围与入选图| publish
  publish -->|Mesh 内网投递| online
  api --> online
  backup -->|Mesh 只读快照| pg
%% h5 | 服务器端 loader 获取作品、角色、章节和场景。 | apps/web/src/features/worlds/api.ts
%% ios | SwiftUI 使用正式站公开 JSON，支持从场景回到段落。 | apps/ios/server/reader.server.ts
%% bench | 观察来源、选题、编辑与发布结果。 | apps/web/src/features/workbench/feed.ts
%% api | 在线 Gin 提供正式站公开读模型和读者业务。 | apps/api/internal/knowledge/world_api.go
%% admin | 管理接口读取制作库的补集、模型用量及投递历史。 | apps/api/internal/knowledge/usage.go
%% worker | 两类调度器从共享 PostgreSQL 领取任务。 | apps/api/cmd/knowledge-sync/production.go
%% publish | timer 驱动跨库投递，接收端按源定稿指纹幂等。 | apps/api/cmd/reader-release/main.go
%% pi | 工具编排及模型步骤由 Pi Durable 执行。 | apps/agent/src/server.ts
%% state | Pi 保存恢复执行所需的检查点。 | compose.yaml
%% models | Kimi 文本走 Magpie，硅谷使用 OpenAI 图像和视觉模型。 | docs/模型用量与计费.md
%% pg | 广州持有制作数据库，候选与已选媒体文件存于硅谷。 | docs/部署架构.md
%% online | 阿里云在一个事务中安装单集投影并记录回执。 | apps/api/cmd/reader-release/import.sql
%% backup | 从同一源快照导出、恢复并逐表核对，成功后切换库名。 | deploy/pg-backup/backup.sh
