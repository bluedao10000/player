flowchart LR
  sources["双源作品数据<br/>AOD (GitHub) / bangumi-data (npm)<br/>〔外部来源〕"]:::external
  worker["Go 同步 Worker<br/>版本探测 · 校验 · Normalize<br/>〔已实现〕"]:::live
