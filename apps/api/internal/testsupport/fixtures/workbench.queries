-- name: SourceMark
INSERT INTO knowledge_source_review_marks(world_slug,source_record_id,last_run_id,source_version_id,changes)
SELECT 'tidepost',r.id,v.run_id,v.id,
 '{"kind":"updated","fields":{"title":{"before":"旧标题","after":"新标题"}},"catalog":{}}'::jsonb
FROM knowledge_source_records r JOIN knowledge_source_versions v ON v.id=r.version_id
JOIN work_worlds w ON w.work_id=r.work_id AND w.slug='tidepost'
LIMIT 1;

-- name: RefreshSourceMark
UPDATE knowledge_source_review_marks SET last_run_id=(
 SELECT id FROM knowledge_sync_runs WHERE id<>last_run_id ORDER BY started_at DESC LIMIT 1
) WHERE world_slug='tidepost';

-- name: ExpireDecision
UPDATE workbench_inbox SET expires_at=clock_timestamp()-interval '1 second' WHERE id=$1;

-- name: AuditCount
SELECT count(*) FROM workbench_decision_actions WHERE decision_id=$1;

-- name: SourceResolved
SELECT resolved_at IS NOT NULL FROM knowledge_source_review_marks WHERE world_slug='tidepost';

-- name: PriceFixture
INSERT INTO billing_rates(kind,endpoint,provider_account,model,currency,effective_at,unit,unit_micros,created_by)
VALUES('cost','http://workbench-model.test','fixture','folio-test','USD',now()-interval '1 day',
 'total_tokens',1000000,'fixture');

-- name: MeasuredRunCost
SELECT cost_usd::text FROM workbench_runs WHERE id=$1;

-- name: WorkCounts
SELECT jsonb_build_object(
 'all',(SELECT count(*) FROM workbench_work_summary),
 'processed',(SELECT count(*) FROM workbench_profiles WHERE verified_entity_count>0));

-- name: SeedKnowledgeTrend
WITH live AS (
 SELECT coalesce(sum(verified_items),0) AS n FROM workbench_verified_knowledge
), days AS (
 SELECT * FROM (VALUES
  (($1::date-1),5,(SELECT n FROM live)),
  ($1::date,8,(SELECT greatest(n-3,0) FROM live))
 ) d(day,chapters,verified_items)
)
INSERT INTO ops_daily_snapshots(day,scope,definition,metrics)
SELECT day,'all',2,jsonb_build_object('knowledge',jsonb_build_object('chapters',chapters),
 'verifiedItems',verified_items)
FROM days;
