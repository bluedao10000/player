-- name: SeedOpsTopologyBoundaryRuns
WITH source AS (
 SELECT id FROM knowledge_sources WHERE name='tidepost-original'
), runs(finished_at,duration_seconds) AS (
 VALUES ($1::timestamptz-interval '1 hour',10::double precision),
        ($1::timestamptz-interval '2 hours',20::double precision),
        ($1::timestamptz-interval '3 hours',100::double precision),
        ($1::timestamptz-interval '24 hours',1::double precision),
        ($1::timestamptz-interval '24 hours'-interval '1 microsecond',1::double precision),
        ($1::timestamptz,1::double precision)
)
INSERT INTO knowledge_sync_runs(source_id,status,started_at,finished_at)
SELECT source.id,'success',runs.finished_at-runs.duration_seconds*interval '1 second',runs.finished_at
FROM source CROSS JOIN runs

