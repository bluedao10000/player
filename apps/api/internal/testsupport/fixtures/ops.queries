-- name: SeedOpsSyncRuns
WITH source AS (
 SELECT id FROM knowledge_sources WHERE name='tidepost-original'
), states(status,skipped,offset_seconds,error_message,skip_reason) AS (
 VALUES ('pending',false,5,NULL,NULL),
        ('running',false,4,NULL,NULL),
        ('success',true,3,NULL,'version_unchanged'),
        ('success',false,2,NULL,NULL),
        ('failed',false,1,'fixture source error',NULL)
)
INSERT INTO knowledge_sync_runs(source_id,status,skipped,started_at,finished_at,error_message,skip_reason)
SELECT source.id,states.status,states.skipped,now()-states.offset_seconds*interval '1 second',
 CASE WHEN states.status IN ('success','failed') THEN now()-states.offset_seconds*interval '1 second' END,
 states.error_message,states.skip_reason
FROM source CROSS JOIN states

-- name: SeedOpsWorlds
WITH version_source AS (
 SELECT s.id AS source_id,r.id AS run_id
 FROM knowledge_sources s JOIN knowledge_sync_runs r ON r.source_id=s.id
 WHERE s.name='tidepost-original' AND r.status='success'
 ORDER BY r.started_at LIMIT 1
), world_inputs(slug,version,name,edition,origin,title) AS (
 VALUES ('tidepost','ops-tidepost-v1','Tidepost fixture','Test edition','original','Ops Tidepost'),
        ('cowboy-bebop-tv','ops-bebop-v1','Bebop fixture','Test edition','external','Ops Bebop')
), versions AS (
 INSERT INTO knowledge_source_versions(source_id,version,checksum,metadata,run_id)
 SELECT source_id,world_inputs.version,md5(world_inputs.version),'{}'::jsonb,run_id
 FROM version_source CROSS JOIN world_inputs
 RETURNING id,version
), works AS (
 INSERT INTO works(canonical_title,type)
 SELECT title,'TV' FROM world_inputs
 RETURNING id,canonical_title
), releases AS (
 INSERT INTO world_releases(version_id,work_id)
 SELECT versions.id,works.id
 FROM versions JOIN world_inputs ON world_inputs.version=versions.version
 JOIN works ON works.canonical_title=world_inputs.title
 RETURNING version_id,work_id
), worlds AS (
 INSERT INTO work_worlds(work_id,slug,version_id,name,edition,intro,cast_title,origin)
 SELECT releases.work_id,world_inputs.slug,releases.version_id,world_inputs.name,
  world_inputs.edition,'fixture','Fixture cast',world_inputs.origin
 FROM releases JOIN world_inputs ON true
 JOIN versions ON versions.id=releases.version_id AND versions.version=world_inputs.version
 RETURNING slug
)
SELECT count(*) FROM worlds

