-- name: OpsCaptureResearchDuplicateCount
SELECT count(*)::int
FROM ops_task_runs r JOIN ops_work_items w
 ON w.world_slug=r.world_slug AND w.episode=r.episode_first
WHERE r.status='running' AND r.source_table='episode_capture_attempts'
 AND r.source_id=(SELECT id::text FROM episode_capture_attempts WHERE topic='ops-capture-running')
UNION ALL
