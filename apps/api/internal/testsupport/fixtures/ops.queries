-- name: SeedOpsEditors
WITH states(status,has_lease) AS (
 VALUES ('evidence',true),('drafting',true),('checking',true),('evidence',false),
        ('drafting',false),('checking',false),('review',false),('published',false),
        ('failed',false),('conflict',false)
)
INSERT INTO editor_tasks(request_id,world,chapter,instruction,author,status,lease,base,issue,published_at)
SELECT gen_random_uuid(),'tidepost','ops-editor-'||row_number() OVER (),
 'fixture instruction','fixture',states.status,
 CASE WHEN states.has_lease THEN gen_random_uuid() END,'{}'::jsonb,
 CASE WHEN states.status IN ('failed','conflict') THEN 'fixture editorial error' ELSE '' END,
 CASE WHEN states.status='published' THEN now() END
FROM states

-- name: SeedOpsMediaSteps
WITH steps(step,first_slot) AS (
 VALUES ('reference',1),('generate',4),('review',7),('recrop',10),('recheck',13)
), states(status,slot_offset) AS (
 VALUES ('running',0),('success',1),('failed',2)
), candidates AS (
 SELECT steps.step,steps.first_slot+states.slot_offset AS slot,states.status
 FROM steps CROSS JOIN states
)
INSERT INTO media_steps(slot,round,step,attempt,started_at,finished_at,result,error)
SELECT slot,1,step,1,now()-interval '3 seconds',
 CASE WHEN status='running' THEN NULL ELSE now()-interval '1 second' END,
 CASE WHEN status='success' THEN '{"decision":"pass"}'::jsonb END,
 CASE WHEN status='failed' THEN 'fixture media error' END
FROM candidates

