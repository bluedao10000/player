FROM ops_task_runs r JOIN ops_work_items w
 ON w.world_slug=r.world_slug AND w.episode=r.episode_first
WHERE r.status='running' AND r.source_table='research_runs'
 AND r.source_id=(SELECT id::text FROM research_runs WHERE topic='ops-research-collect')

