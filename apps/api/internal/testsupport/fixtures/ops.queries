-- name: SeedOpsOverviewRuns
WITH source AS (
 SELECT id FROM knowledge_sources WHERE name='tidepost-original'
), clock AS (
 SELECT date_trunc('day',now() AT TIME ZONE 'Asia/Shanghai') AT TIME ZONE 'Asia/Shanghai' AS day_start
), boundary(status,offset_seconds) AS (
 VALUES ('success',-1),('failed',-1),('success',1),('failed',1)
)
INSERT INTO knowledge_sync_runs(source_id,status,skipped,started_at,finished_at,error_message)
SELECT source.id,boundary.status,false,
 clock.day_start+boundary.offset_seconds*interval '1 second'-interval '1 minute',
 clock.day_start+boundary.offset_seconds*interval '1 second',
 CASE WHEN boundary.status='failed' THEN 'overview fixture failure' END
FROM source CROSS JOIN clock CROSS JOIN boundary;

INSERT INTO knowledge_sync_runs(source_id,status,skipped,started_at,finished_at,error_message)
SELECT id,'running',false,now(),NULL,NULL
FROM knowledge_sources WHERE name='tidepost-original';

INSERT INTO knowledge_quality_runs(status,started_at,finished_at,error_message)
VALUES ('running',now(),NULL,NULL),
       ('failed',now()-interval '2 minutes',now()-interval '1 minute','recent overview failure');

-- name: OpsOverviewExpectedLiveMetrics
WITH clock AS (
 SELECT statement_timestamp() AS as_of,
  date_trunc('day',statement_timestamp() AT TIME ZONE 'Asia/Shanghai') AT TIME ZONE 'Asia/Shanghai' AS day_start
)
SELECT jsonb_build_object(
 'metrics',jsonb_build_object(
  'online_workers',(SELECT count(DISTINCT worker_id)::int FROM ops_worker_heartbeats h CROSS JOIN clock c
   WHERE NOT (h.last_ok_at IS NULL OR h.last_ok_at<c.as_of-GREATEST(h.expected_seconds*3,120)*interval '1 second')),
  'running_executions',(SELECT coalesce(sum(coalesce((h.executions->>'media')::int,0)+coalesce((h.executions->>'research')::int,0)+coalesce((h.executions->>'editorial')::int,0)+coalesce((h.executions->>'configuration')::int,0)),0)::int FROM ops_worker_heartbeats h CROSS JOIN clock c WHERE h.role='agent' AND NOT (h.last_ok_at IS NULL OR h.last_ok_at<c.as_of-GREATEST(h.expected_seconds*3,120)*interval '1 second')),
  'running_tasks',(SELECT count(*)::int FROM ops_task_runs WHERE status='running'),
  'pending_work',(SELECT count(*)::int FROM ops_work_items WHERE state='pending'),
  'blocked_work',(SELECT count(*)::int FROM ops_work_items WHERE state='blocked'),
  'waiting_human',(SELECT count(*)::int FROM ops_work_items WHERE state='waiting_human'),
  'completed_today',(SELECT count(*)::int FROM ops_task_runs r CROSS JOIN clock c WHERE r.status='success' AND r.finished_at>=c.day_start AND r.finished_at<c.day_start+interval '1 day'),
  'failed_today',(SELECT count(*)::int FROM ops_task_runs r CROSS JOIN clock c WHERE r.status='failed' AND r.finished_at>=c.day_start AND r.finished_at<c.day_start+interval '1 day')),
 'boundary',jsonb_build_object(
  'success_before',(SELECT count(*)::int FROM ops_task_runs r CROSS JOIN clock c WHERE r.source_table='knowledge_sync_runs' AND r.status='success' AND r.finished_at<c.day_start),
  'success_today',(SELECT count(*)::int FROM ops_task_runs r CROSS JOIN clock c WHERE r.source_table='knowledge_sync_runs' AND r.status='success' AND r.finished_at>=c.day_start AND r.finished_at<c.day_start+interval '1 day'),
  'failed_before',(SELECT count(*)::int FROM ops_task_runs r CROSS JOIN clock c WHERE r.source_table='knowledge_sync_runs' AND r.status='failed' AND r.finished_at<c.day_start),
  'failed_today',(SELECT count(*)::int FROM ops_task_runs r CROSS JOIN clock c WHERE r.source_table='knowledge_sync_runs' AND r.status='failed' AND r.finished_at>=c.day_start AND r.finished_at<c.day_start+interval '1 day')))

