-- name: SeedOpsEpisodeRuns
WITH seeds(topic,number,kind) AS (
 VALUES ('ops-capture-running',901,'capture_running'),
        ('ops-capture-failed',902,'capture_failed'),
        ('ops-research-collect',903,'research_collect'),
        ('ops-capture-success',904,'capture_success'),
        ('ops-research-write',905,'research_write'),
        ('ops-research-ready',906,'research_ready'),
        ('ops-research-failed',907,'research_failed'),
        ('ops-accept-pass',908,'accept_pass'),
        ('ops-accept-reject',909,'accept_reject'),
        ('ops-release-running',910,'release_running'),
        ('ops-release-success',911,'release_success'),
        ('ops-release-failed',912,'release_failed')
), topics AS (
 INSERT INTO research_topics(id,world_slug,first_episode,last_episode)
 SELECT topic,'tidepost',number,number FROM seeds
 RETURNING id,world_slug,first_episode,last_episode
), plans AS (
 INSERT INTO episode_plans(topic,world_slug,number,spec)
 SELECT t.id,t.world_slug,t.first_episode,jsonb_build_object('slug',t.id,'sceneSlug',t.id||'-scene')
 FROM topics t RETURNING topic,world_slug,number
), capture_runs AS (
 INSERT INTO episode_capture_attempts(topic,started_at,finished_at,error)
 SELECT p.topic,now()-interval '3 seconds',
  CASE WHEN s.kind='capture_running' THEN NULL ELSE now()-interval '2 seconds' END,
  CASE WHEN s.kind='capture_failed' THEN 'fixture capture error' END
 FROM plans p JOIN seeds s ON s.topic=p.topic
 WHERE s.kind LIKE 'capture_%'
 RETURNING id
), research_runs AS (
 INSERT INTO research_runs(topic,v,attempt,stage,started_at,finished_at,documents,claims,error)
 SELECT t.id,w.version_id,1,
  CASE s.kind WHEN 'research_collect' THEN 'collect' WHEN 'research_write' THEN 'write'
       WHEN 'research_ready' THEN 'ready' ELSE 'failed' END,
  now()-interval '3 seconds',
  CASE WHEN s.kind IN ('research_ready','research_failed') THEN now()-interval '1 second' END,
  CASE WHEN s.kind='research_ready' THEN '[]'::jsonb END,
  CASE WHEN s.kind='research_ready' THEN '[]'::jsonb END,
  CASE WHEN s.kind='research_failed' THEN 'fixture research error' END
 FROM topics t JOIN seeds s ON s.topic=t.id
 JOIN work_worlds w ON w.slug=t.world_slug
 WHERE s.kind LIKE 'research_%'
 RETURNING id
), acceptances AS (
 INSERT INTO scope_acceptances(topic,v,rule,fingerprint,edition_slug,scope_first,scope_last,passed,checks,picks,checked_at)
 SELECT t.id,w.version_id,1,'ops-fixture:'||t.id,t.world_slug,t.first_episode,t.last_episode,
  s.kind IN ('accept_pass','release_running','release_success','release_failed'),
  '{}'::jsonb,'[]'::jsonb,now()-interval '1 second'
 FROM topics t JOIN seeds s ON s.topic=t.id
 JOIN work_worlds w ON w.slug=t.world_slug
 WHERE s.kind LIKE 'accept_%' OR s.kind LIKE 'release_%'
 RETURNING id,topic
), release_runs AS (
 INSERT INTO reader_release_attempts(topic,acceptance,started_at,finished_at,target_id,href,error)
 SELECT a.topic,a.id,now()-interval '2 seconds',
  CASE WHEN s.kind='release_running' THEN NULL ELSE now()-interval '1 second' END,
  CASE WHEN s.kind='release_success' THEN 19011 END,
  CASE WHEN s.kind='release_success' THEN '/chapter/ops-fixture' END,
  CASE WHEN s.kind='release_failed' THEN 'fixture release error' END
 FROM acceptances a JOIN seeds s ON s.topic=a.topic
 WHERE s.kind LIKE 'release_%'
 RETURNING id
)
SELECT count(*) FROM release_runs

