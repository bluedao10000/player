       (SELECT count(*) FROM ops_stages),
       (SELECT count(*) FROM ops_media_batch_worlds),
       (SELECT count(*) FROM information_schema.columns WHERE table_schema=current_schema()
        AND table_name='episode_policy_queue' AND column_name='status_code'),
       (SELECT count(*) FROM ops_stages WHERE topology_group IS NOT NULL),
       (SELECT count(*) FROM ops_stage_worker_loops),
       (SELECT topology_group IS NULL FROM ops_stages WHERE id='backup')

