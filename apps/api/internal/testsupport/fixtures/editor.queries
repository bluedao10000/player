-- name: CountActiveEditorTasks
SELECT count(*) FROM editor_tasks WHERE status IN ('evidence','drafting','checking')

-- name: EditorStatus
select status from editor_tasks where id=$1

-- name: ProfileSnapshot
select editor_task_snapshot($1,$2,'profiles')

-- name: CreateProfileReview
INSERT INTO editor_tasks(request_id,world,chapter,kind,instruction,author,base,base_head,status,draft)
 SELECT gen_random_uuid(),$1,$2,'profiles','修改介绍','tester',editor_task_snapshot($1,$2,'profiles'),(SELECT task FROM editor_heads WHERE world=$1 AND chapter IS NULL),'review',$3 RETURNING id

-- name: PublishedProfiles
SELECT editor_profile_text(editor_public_profile(editor_raw_person($1,'mio'),$1,'person/mio'),'person/mio'),
 editor_profile_text(editor_public_profile(editor_raw_overview($1),$1,'world/setting'),'world/setting')

-- name: PreviewWorldSetting
select (editor_profile_preview(base,draft)#>>'{profile_pages,world/setting,world_setting}') from editor_tasks where id=$1

-- name: CountChapterHeads
SELECT count(*) FROM editor_heads WHERE world=$1 AND chapter IS NOT NULL
