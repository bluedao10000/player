-- name: CreateNarutoEdition
WITH k AS (INSERT INTO works(canonical_title,type,season_year) VALUES('fixture','TV',2002) RETURNING id) INSERT INTO work_sources SELECT id,'bangumi','3425','https://bgm.tv/subject/3425' FROM k

-- name: FirstFiveSlugs
SELECT string_agg(id||':'||(spec->>'slug'),',' ORDER BY number) FROM episode_plans WHERE number<=5

-- name: SeedBlockedSourceBundleRequests
INSERT INTO episode_production_requests(id,world,first_episode,last_episode,token_limit,operator_paused,paused_reason,stage,production_policy)
SELECT gen_random_uuid(),'naruto-tv-2002',n,n,60000,true,'待补可复用的同版本来源模板','blocked','{"queue":"test"}'
FROM generate_series(6,7) n;

-- name: AttachedSourceBundleCount
SELECT count(*) FROM episode_production_requests
WHERE world='naruto-tv-2002' AND stage='inventory' AND operator_paused AND paused_reason='等待广州批次'
  AND production_policy->'source_bundle'->>'ruleSha256'=$1 AND revision=2;

-- name: MoveSourceBundleToConfiguration
UPDATE episode_production_requests SET stage='plan_validated',operator_paused=false,paused_reason=NULL,gaps=ARRAY[6]
WHERE world='naruto-tv-2002' AND first_episode=6;

-- name: PlanGraphCounts
SELECT (SELECT count(*) FROM episode_plans),(SELECT count(*) FROM episode_art_jobs),(SELECT count(*) FROM world_releases)

-- name: PublishedHeads
SELECT count(*),count(published) FROM scope_heads

-- name: CreateONAEdition
WITH k AS (INSERT INTO works(canonical_title,type,season_year,status,episodes) VALUES('fixture','ONA',2025,'FINISHED',6) RETURNING id) INSERT INTO work_sources SELECT id,'bangumi','527620','https://bgm.tv/subject/527620' FROM k

-- name: ONACoverage
SELECT (SELECT count(*) FROM episode_plans WHERE world_slug=$1),(SELECT count(*) FROM published_episode_scopes WHERE world_slug=$1)

-- name: FailImageProvider
UPDATE media_candidates SET art_job=(SELECT min(id) FROM episode_art_jobs),stage='failed',reason='模型服务 HTTP 403' WHERE slot IN (1,2);
		INSERT INTO media_steps(slot,round,step,attempt,error,finished_at) VALUES
		(1,1,'generate',1,'模型服务 HTTP 502',now()),(1,1,'generate',2,'模型服务 HTTP 403',now()),
		(2,1,'review',1,'模型服务 HTTP 403',now())

-- name: RequeuedImage
SELECT attempt,(SELECT count(*) FROM media_steps WHERE slot=1) FROM media_candidates WHERE slot=1 AND stage='generate'
