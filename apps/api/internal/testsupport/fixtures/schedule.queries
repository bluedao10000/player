-- name: CreateScheduleEdition
WITH k AS (INSERT INTO works(canonical_title,type,season_year) VALUES('fixture','TV',1998) RETURNING id) INSERT INTO work_sources SELECT id,'fixture','1','https://example.com' FROM k

-- name: CountAdmissions
SELECT count(*) FROM episode_admissions

-- name: InsertMissingEpisodes
INSERT INTO episode_inventory_snapshots VALUES(now(),'[{"slug":"schedule-fixture","missing":[5,6]}]')

-- name: QueueStatus
SELECT status FROM episode_policy_queue WHERE number=6

-- name: SetChatEditionLength
UPDATE works SET episodes=$1 WHERE id=(SELECT work_id FROM work_worlds WHERE slug='tidepost')

-- name: SeedChatRetry
WITH topic AS (
 INSERT INTO research_topics(id,world_slug,first_episode,last_episode) VALUES('chat-fixture-009','tidepost',9,9) RETURNING id
), ep AS (
 INSERT INTO episode_plans(topic,world_slug,number,spec) SELECT id,'tidepost',9,'{"slug":"chat-fixture-009","sceneSlug":"chat-fixture-scene"}' FROM topic RETURNING *
), spec AS (
 INSERT INTO episode_request_specs(request_id,revision,world_slug,number,spec,documents)
 SELECT $1,1,world_slug,number,spec,'[]' FROM ep
)
INSERT INTO research_runs(topic,v,attempt,stage,finished_at,error)
SELECT topic,(SELECT version_id FROM work_worlds WHERE slug='tidepost'),1,'failed',now(),'fixture provider failure' FROM ep

-- name: ChatRetryPolicy
SELECT policy FROM research_topics WHERE id='chat-fixture-009'

-- name: ChatOperationCount
SELECT count(*) FROM workbench_plan_operations WHERE plan_id=$1

-- name: ChatTurnOperationCount
SELECT count(*) FROM workbench_plan_operations WHERE request_id=$1

-- name: ChangeChatProposalWorld
UPDATE workbench_chat_turns SET proposal=jsonb_set(proposal,'{world}',to_jsonb($2::text)),
 diff=jsonb_set(diff,'{world,1}',to_jsonb($2::text))
WHERE id=$1

-- name: ChangeChatProposalPublish
UPDATE workbench_chat_turns SET proposal=jsonb_set(proposal,'{publish_to_reader}','true') WHERE id=$1
