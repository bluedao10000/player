-- name: RecordEditorEvent
INSERT INTO editor_events(task,round,attempt,stage,note,detail) SELECT id,round,attempt,$2,$3,$4 FROM editor_tasks WHERE id=$1

-- name: LockEditorTask
SELECT world,chapter,kind,status,round,attempt,draft,base FROM editor_tasks WHERE id=$1 FOR UPDATE

-- name: ReturnEditorTask
UPDATE editor_tasks SET round=round+1,attempt=1,status='evidence',feedback=$2,issue='',retries=0,due=now(),lease=NULL WHERE id=$1

-- name: LockEditorHead
SELECT pg_advisory_xact_lock(hashtextextended($1,33))

-- name: CompareEditBase
SELECT t.base=editor_task_snapshot(t.world,t.chapter,t.kind) AND t.base_head IS NOT DISTINCT FROM h.task,coalesce(h.patch,'{}') FROM editor_tasks t LEFT JOIN editor_heads h ON h.world=t.world AND h.chapter IS NOT DISTINCT FROM $2::text WHERE t.id=$1

-- name: MarkEditConflict
UPDATE editor_tasks SET status='conflict',issue='公开定稿已更新，请按最新版本新建任务' WHERE id=$1

-- name: PublishEditorHead
INSERT INTO editor_heads(world,chapter,task,patch) VALUES($1,$2,$3,$4) ON CONFLICT(world,chapter) DO UPDATE SET task=excluded.task,patch=excluded.patch

-- name: MarkEditPublished
UPDATE editor_tasks SET status='published',reviewer=$2,published_at=now() WHERE id=$1

-- name: CreateEditorTask
INSERT INTO editor_tasks(request_id,world,chapter,instruction,author,base,base_head,kind)
 SELECT $1,$2,$3,$4,$5,base,(SELECT task FROM editor_heads WHERE world=$2 AND chapter IS NOT DISTINCT FROM (CASE WHEN $6='chapter' THEN $3::text END)),$6 FROM editor_task_snapshot($2,$3,$6) base WHERE base IS NOT NULL
 ON CONFLICT(request_id) DO NOTHING RETURNING id

-- name: FindDuplicateTask
SELECT id FROM editor_tasks WHERE request_id=$1 AND world=$2 AND chapter=$3 AND instruction=$4 AND author=$5 AND kind=$6
