-- name: CreateEditorSession
WITH clean AS(DELETE FROM editor_sessions WHERE expires_at<=now()) INSERT INTO editor_sessions(hash,operator) VALUES($1,$2)

-- name: EditorSessionOperator
SELECT operator FROM editor_sessions WHERE hash=$1 AND expires_at>now()

-- name: DeleteEditorSession
DELETE FROM editor_sessions WHERE hash=$1

-- name: RegisterWorkbenchAccount
INSERT INTO workbench_accounts(email) VALUES($1) ON CONFLICT DO NOTHING

-- name: SetWorkbenchPassword
UPDATE workbench_accounts SET password_digest=$2,password_attempts=0,password_window=NULL WHERE email=$1

-- name: RevokeWorkbenchSessions
DELETE FROM editor_sessions WHERE operator='email:'||$1

-- name: AttemptWorkbenchPassword
UPDATE workbench_accounts
SET password_attempts=CASE WHEN password_window>now()-interval '15 minutes' THEN password_attempts+1 ELSE 1 END,
    password_window=CASE WHEN password_window>now()-interval '15 minutes' THEN password_window ELSE now() END
WHERE email=$1 AND password_digest IS NOT NULL
  AND (password_window IS NULL OR password_window<=now()-interval '15 minutes' OR password_attempts<5)
RETURNING password_digest

-- name: ResetWorkbenchPasswordAttempts
UPDATE workbench_accounts SET password_attempts=0,password_window=NULL WHERE email=$1
