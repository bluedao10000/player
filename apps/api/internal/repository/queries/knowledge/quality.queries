-- name: LockProjection
SELECT pg_advisory_xact_lock(82045102)

-- name: CreateQualityScope
CREATE TEMP TABLE scope(work_id uuid PRIMARY KEY) ON COMMIT DROP

-- name: FillQualityScope
INSERT INTO scope SELECT id FROM works w WHERE active AND ($1='all' OR EXISTS(SELECT FROM knowledge_source_records r JOIN knowledge_sources s ON s.id=r.source_id WHERE r.active AND r.work_id=w.id AND s.name=$1)) AND ($2='' OR id=nullif($2,'')::uuid)

-- name: QualityReport
SELECT jsonb_build_object('works',count(*),'mean_score',round(avg(score),2),'issues',coalesce((SELECT jsonb_object_agg(rule_id,n) FROM (SELECT rule_id,count(*) n FROM knowledge_quality_issues JOIN scope ON entity_id=work_id WHERE status='open' GROUP BY 1) a),'{}')) FROM knowledge_quality_scores JOIN scope USING(work_id)
