-- name: ChatChoices
SELECT jsonb_build_object(
 'works', coalesce((SELECT jsonb_agg(jsonb_build_object('slug',slug,'name',name,'edition',edition) ORDER BY name) FROM work_worlds),'[]'),
 'tasks', coalesce((SELECT jsonb_agg(jsonb_build_object('id',id,'world',world,'chapter',chapter,'status',status) ORDER BY created_at DESC) FROM (SELECT * FROM editor_tasks ORDER BY created_at DESC LIMIT 100)t),'[]'),
 'plans', coalesce((SELECT jsonb_agg(jsonb_build_object('id',id,'world',world,'first_episode',first_episode,'last_episode',last_episode,'stage',stage) ORDER BY created_at DESC) FROM episode_production_requests),'[]'))

-- name: ChatContext
SELECT jsonb_build_object(
 'completeness',coalesce((SELECT jsonb_agg(jsonb_build_object('dimension',r.dimension,'item_code',r.item_code,'data_state',r.data_state,
    'completed',r.completed_required_items,'applicable',r.applicable_required_items,'status',r.status,
    'gaps',(SELECT coalesce(jsonb_agg(jsonb_build_object('key',d->>'item_key','status',d->>'status','reason',left(coalesce(d->>'reason',''),140))),'[]'::jsonb)
      FROM (SELECT d FROM jsonb_array_elements(r.details) d WHERE d->>'status' IN ('missing','pending_verification') LIMIT 6) sub)))
   FROM (
    SELECT DISTINCT ON (x.rule_code) x.* FROM knowledge_completeness_results x
    WHERE x.work_id=w.work_id AND x.version_id=w.version_id
      AND x.rule_version=(SELECT max(rr.rule_version) FROM knowledge_completeness_rules rr WHERE rr.rule_code=x.rule_code AND rr.active)
    ORDER BY x.rule_code,x.rule_version DESC,x.calculated_at DESC
   ) r),'[]'::jsonb),
 'governance',jsonb_build_object(
   'open_match_candidates',(SELECT count(*)::int FROM knowledge_match_candidates mc LEFT JOIN knowledge_source_records sr ON sr.id=mc.source_record_id WHERE mc.candidate_work_id=w.work_id OR sr.work_id=w.work_id),
   'open_quality_issues',(SELECT count(*)::int FROM knowledge_quality_issues qi WHERE qi.entity_id=w.work_id AND qi.status='open'),
   'active_plans',(SELECT coalesce(jsonb_agg(jsonb_build_object('id',p.id,'first_episode',p.first_episode,'last_episode',p.last_episode,'stage',p.stage,'token_limit',p.token_limit,'consumed',p.consumed,'reserved',p.reserved,'operator_paused',p.operator_paused) ORDER BY p.created_at DESC),'[]'::jsonb)
     FROM (SELECT * FROM episode_production_requests WHERE world=w.slug AND stage NOT IN ('published','local_ready') ORDER BY created_at DESC LIMIT 5) p)
  ),
 'work',jsonb_build_object('slug',w.slug,'name',w.name,'edition',w.edition,'episodes',k.episodes,'type',k.type),
 'editor_task',(SELECT jsonb_build_object('id',id,'chapter',chapter,'status',status,'issue',left(issue,500),'round',round,'attempt',attempt) FROM editor_tasks WHERE id=$4 AND world=w.slug),
 'inventory', (SELECT jsonb_build_object('checked_at',s.checked_at,'record',entry) FROM (SELECT * FROM episode_inventory_snapshots ORDER BY checked_at DESC LIMIT 1)s, jsonb_array_elements(s.works) entry WHERE entry->>'slug'=w.slug LIMIT 1),
 'plan',(SELECT to_jsonb(p) FROM episode_production_requests p WHERE p.id=$2 AND p.world=w.slug),
 'episodes',coalesce((SELECT jsonb_agg(to_jsonb(ep)) FROM (
   SELECT p.number,p.topic,p.spec->>'title' AS title,r.stage,left(r.error,500) AS error,r.attempt,a.passed,
          (SELECT jsonb_agg(jsonb_build_object('name',dimension->>'name','gaps',
           (SELECT jsonb_agg(left(item->>'gap',180))
            FROM jsonb_array_elements(CASE WHEN jsonb_typeof(dimension->'items')='array' THEN dimension->'items' ELSE '[]'::jsonb END) item
            WHERE item?'gap')))
           FROM jsonb_array_elements(CASE WHEN jsonb_typeof(a.checks)='array' THEN a.checks ELSE '[]'::jsonb END) dimension) AS checks,
          rel.target_id AS receipt,rel.href,rel.error AS release_error
   FROM episode_plans p LEFT JOIN scope_heads h ON h.topic=p.topic
   LEFT JOIN scope_acceptances a ON a.id=h.latest
   LEFT JOIN LATERAL (SELECT stage,error,attempt FROM research_runs WHERE topic=p.topic ORDER BY started_at DESC LIMIT 1) r ON true
   LEFT JOIN LATERAL (SELECT target_id,href,error FROM reader_release_attempts WHERE topic=p.topic ORDER BY started_at DESC LIMIT 1) rel ON true
   WHERE p.world_slug=w.slug AND ($3::int=0 OR p.number=$3) ORDER BY p.number DESC LIMIT 12
 ) ep),'[]'),
 'media',coalesce((SELECT jsonb_agg(to_jsonb(m)) FROM (
   SELECT c.slot,c.variant,c.stage,c.round,left(c.reason,500) AS reason,j.spec->>'episode' AS episode,j.spec->>'title' AS title
   FROM episode_art_jobs j JOIN media_candidates c ON c.art_job=j.id WHERE j.world_slug=w.slug
   AND ($3=0 OR j.spec->>'episode'=$3::text) ORDER BY c.updated_at DESC LIMIT 12
 ) m),'[]'),
 'history',coalesce((SELECT jsonb_agg(to_jsonb(e)) FROM (
   SELECT r.topic,r.stage,r.error,r.attempt,r.started_at,r.finished_at
   FROM research_runs r JOIN research_topics t ON t.id=r.topic WHERE t.world_slug=w.slug
   AND ($3=0 OR $3 BETWEEN t.first_episode AND t.last_episode) ORDER BY r.started_at DESC LIMIT 12
 ) e),'[]'))
FROM work_worlds w JOIN works k ON k.id=w.work_id WHERE w.slug=$1

-- name: ChatHistory
SELECT coalesce(jsonb_agg(to_jsonb(t)-'owner' ORDER BY created_at,id),'[]')
FROM (SELECT t.id,t.owner,t.world,t.plan_id,t.task_id,t.episode,t.prompt,
 CASE WHEN t.state='running' AND t.updated_at<now()-interval '3 minutes' THEN 'Pi 未返回本轮结果，请重发。' ELSE t.reply END AS reply,
 t.tools,t.proposal,t.diff,
 CASE WHEN t.state='running' AND t.updated_at<now()-interval '3 minutes' THEN 'failed' ELSE t.state END AS state,
 t.created_at,t.updated_at FROM workbench_chat_turns t WHERE owner=$1 ORDER BY created_at DESC,id DESC LIMIT 100)t

-- name: ChatStart
INSERT INTO workbench_chat_turns(id,owner,world,plan_id,episode,prompt,task_id)
VALUES($1,$2,$3,$4,$5,$6,$7) ON CONFLICT DO NOTHING

-- name: ChatRequestMatches
SELECT EXISTS(SELECT FROM workbench_chat_turns WHERE id=$1 AND owner=$2 AND world=$3
  AND plan_id IS NOT DISTINCT FROM $4 AND episode=$5 AND prompt=$6 AND task_id IS NOT DISTINCT FROM $7)

-- name: ChatFinish
UPDATE workbench_chat_turns SET state=$3,reply=$4,tools=$5,proposal=$6,diff=$7,updated_at=now()
WHERE id=$1 AND owner=$2 AND state='running'

-- name: ChatTurnLock
SELECT state,world,plan_id,proposal,diff FROM workbench_chat_turns WHERE id=$1 AND owner=$2 FOR UPDATE

-- name: ChatResolve
UPDATE workbench_chat_turns SET state=$3,updated_at=now() WHERE id=$1 AND owner=$2

-- name: ChatPlanLock
SELECT to_jsonb(p) FROM (SELECT * FROM episode_production_requests WHERE id=$1 FOR UPDATE)p

-- name: ChatEditionSize
SELECT coalesce(k.episodes,0) FROM work_worlds w JOIN works k ON k.id=w.work_id WHERE w.slug=$1 FOR SHARE OF k

-- name: ChatRegisteredScope
SELECT EXISTS(SELECT FROM episode_request_specs WHERE request_id=$1 AND (world_slug<>$2 OR number NOT BETWEEN $3 AND $4))

-- name: ChatUpdatePlan
UPDATE episode_production_requests SET world=$2,first_episode=$3,last_episode=$4,token_limit=$5,
 production_policy=$6,operator_paused=$7,revision=revision+1,updated_at=now(),
 paused_reason=CASE WHEN $5>token_limit AND paused_reason IN ('insufficient_remaining_tokens','token_limit_reached') THEN NULL ELSE paused_reason END,
 stage=CASE WHEN $8 THEN 'inventory' ELSE stage END,
 gaps=CASE WHEN $8 THEN '{}' ELSE gaps END,
 plan_brief=CASE WHEN $8 THEN NULL ELSE plan_brief END
WHERE id=$1 AND revision=$9

-- name: ChatPlanNote
INSERT INTO episode_plan_messages(request_id,revision,instruction,author) VALUES($1,$2,$3,$4)

-- name: ChatAudit
INSERT INTO workbench_plan_operations(request_id,plan_id,actor,tool,previous_revision,new_revision,diff)
VALUES($1,$2,$3,$4,$5,$6,$7)

-- name: ChatEpisodeTopic
SELECT p.topic,
  EXISTS(SELECT FROM visible_reader_scopes v WHERE v.world_slug=p.world_slug AND p.number BETWEEN v.first_episode AND v.last_episode)
   OR EXISTS(SELECT FROM scope_heads h WHERE h.topic=p.topic AND h.published IS NOT NULL)
   OR EXISTS(SELECT FROM work_worlds w JOIN work_chapters c ON c.v=w.version_id WHERE w.slug=p.world_slug AND c.episode=p.number) AS published,
  (SELECT stage FROM research_runs WHERE topic=p.topic ORDER BY started_at DESC LIMIT 1) = 'failed' AS failed
FROM episode_request_specs s JOIN episode_plans p ON p.world_slug=s.world_slug AND p.number=s.number
WHERE s.request_id=$1 AND s.number=$2

-- name: ChatRetryMedia
UPDATE media_candidates c SET stage=step.step,attempt=step.attempt+1,reason='',updated_at=now()
FROM episode_plans p JOIN episode_art_jobs j ON j.world_slug=p.world_slug AND j.slug=p.spec->>'sceneSlug',
 media_steps step
WHERE p.topic=$1 AND c.art_job=j.id AND step.slot=c.slot AND step.round=c.round AND c.stage='failed'
AND step.step IN ('generate','review','recheck') AND step.error=c.reason
AND step.started_at=(SELECT max(m.started_at) FROM media_steps m WHERE m.slot=c.slot AND m.round=c.round)

-- name: ChatResetResearch
UPDATE research_topics SET policy=policy+1,enabled=true WHERE id=$1
AND NOT EXISTS (SELECT FROM research_runs r WHERE r.topic=$1 AND r.policy=research_topics.policy AND r.stage IN ('collect','write'))
AND (NOT $2::boolean OR (SELECT stage FROM research_runs WHERE topic=$1 ORDER BY started_at DESC LIMIT 1)='failed')

-- name: ChatCreatePlan
WITH created AS (
 INSERT INTO episode_production_requests(id,world,first_episode,last_episode,token_limit,production_policy)
 VALUES(gen_random_uuid(),$1,$2,$3,$4,$5)
 RETURNING id,revision
), note AS (
 INSERT INTO episode_plan_messages(request_id,revision,instruction,author)
 SELECT id,revision,$6,$7 FROM created
)
SELECT id::text FROM created

-- name: ChatBindTurnPlan
UPDATE workbench_chat_turns SET plan_id=$3,state='applied',updated_at=now() WHERE id=$1 AND owner=$2
