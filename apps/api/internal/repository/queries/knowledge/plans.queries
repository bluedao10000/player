-- name: RegisterArt
INSERT INTO episode_art_jobs(world_slug,kind,slug,spec) VALUES($1,$2,$3,$4) ON CONFLICT(world_slug,kind,slug) DO UPDATE SET slug=excluded.slug RETURNING spec=$4::jsonb

-- name: ResolveEditionEpisodeCount
SELECT k.episodes FROM work_sources s JOIN works k ON k.id=s.work_id WHERE s.provider=$1 AND s.external_id=$2 AND k.active AND k.type=$3 AND k.season_year=$4 AND k.status='FINISHED'

-- name: FindWorldVersion
SELECT version_id FROM work_worlds WHERE slug=$1

-- name: ResolveEditionWork
SELECT (SELECT DISTINCT k.id FROM work_sources s JOIN works k ON k.id=s.work_id WHERE s.provider=$1 AND s.external_id=$2 AND k.active AND k.type=$4 AND k.season_year=$3)::text

-- name: CreateEditionVersion
WITH r AS (INSERT INTO knowledge_sync_runs(source_id,status,finished_at,remote_version,checksum,records_read,records_created) SELECT id,'success',now(),$1,$2,1,1 FROM knowledge_sources WHERE name='episode-plans' RETURNING id,source_id)
  INSERT INTO knowledge_source_versions(source_id,version,checksum,metadata,run_id,parser_type,asset_name) SELECT source_id,$1,$2,$3,id,'episode-manifest',$1||'.json' FROM r RETURNING id

-- name: CreateWorldRelease
INSERT INTO world_releases VALUES($1,$2)

-- name: RegisterEditionWorld
INSERT INTO work_worlds(work_id,version_id,slug,name,edition,intro,cast_title,origin) VALUES($1,$2,$3,$4,$5,$6,'登场人物','external')

-- name: AppendHomeSlot
INSERT INTO home_world_slots SELECT coalesce(max(position),0)+1,$1 FROM home_world_slots

-- name: RegisterTopic
INSERT INTO research_topics(id,world_slug,first_episode,last_episode) VALUES($1,$2,$3,$3) ON CONFLICT DO NOTHING

-- name: RegisterPlan
INSERT INTO episode_plans(topic,world_slug,number,spec) VALUES($1,$2,$3,$4) ON CONFLICT(topic) DO UPDATE SET topic=excluded.topic RETURNING spec=$4::jsonb

-- name: RegisterExtension
INSERT INTO episode_extensions(topic,slug,title,intro,place,scene_slug,scene_name,people) SELECT $1,s->>'slug',s->>'title',s->>'intro',s->>'place',s->>'sceneSlug',s->>'sceneName',s->'people' FROM (SELECT $2::jsonb s) x ON CONFLICT(topic) DO NOTHING

-- name: HasPortrait
SELECT EXISTS(SELECT FROM edition_reader_art WHERE world_slug=$1 AND kind='character' AND item_slug=$2)

-- name: LockPlanRegistration
SELECT pg_advisory_xact_lock(82045125)

-- name: HasManifest
SELECT EXISTS(SELECT FROM episode_plan_manifests WHERE world_slug=$1 AND checksum=$2)

-- name: SaveManifest
INSERT INTO episode_plan_manifests VALUES($1,$2,now()) ON CONFLICT(world_slug) DO UPDATE SET checksum=excluded.checksum,loaded_at=now()

-- name: EnqueueEpisodeArt
INSERT INTO media_candidates(slot,batch,position,scene,variant,stage,art_job)
 SELECT nextval('episode_candidate_slots'),'cfg-'||a.id,i,a.spec->>'title',i,'reference',a.id
 FROM episode_plans p JOIN episode_art_jobs a ON a.world_slug=p.world_slug CROSS JOIN LATERAL generate_series(1,CASE a.kind WHEN 'scene' THEN 3 ELSE 1 END)i
 WHERE p.topic=$1 AND ((a.kind='scene' AND a.slug=p.spec->>'sceneSlug') OR (a.kind='portrait' AND p.spec->'people' @> jsonb_build_array(jsonb_build_object('slug',a.slug))))
 AND NOT EXISTS(SELECT FROM media_candidates c WHERE c.art_job=a.id AND position=i) ON CONFLICT(batch,position) DO NOTHING

-- name: ListDueAcceptances
SELECT p.topic FROM episode_plans p JOIN research_topics t ON t.id=p.topic AND t.enabled LEFT JOIN scope_heads h ON h.topic=p.topic WHERE h.published IS NULL
AND NOT EXISTS (SELECT FROM episode_request_specs s JOIN episode_production_requests r ON r.id=s.request_id
 WHERE s.world_slug=p.world_slug AND s.number=p.number AND r.operator_paused)
ORDER BY p.number

-- name: TryLockEpisode
SELECT pg_try_advisory_xact_lock(hashtextextended($1,72))

-- name: AcceptanceState
SELECT p.spec,'cfg-'||a.id,coalesce(r.stage,'queued'),coalesce(r.error,''),EXISTS(SELECT FROM scope_heads h WHERE h.topic=p.topic AND h.published IS NOT NULL)
 FROM episode_plans p JOIN episode_art_jobs a ON a.world_slug=p.world_slug AND a.kind='scene' AND a.slug=p.spec->>'sceneSlug'
 LEFT JOIN LATERAL(SELECT stage,error FROM research_runs WHERE topic=p.topic ORDER BY policy DESC,attempt DESC LIMIT 1) r ON true WHERE p.topic=$1

-- name: BumpResearchPolicy
UPDATE research_topics t SET policy=t.policy+1 FROM research_runs r WHERE r.id=$1 AND (r.topic,r.policy)=(t.id,t.policy) AND t.policy<3

-- name: SetAcceptedWorldCover
UPDATE work_worlds SET image=$2 WHERE slug=$1 AND image IS NULL AND EXISTS(SELECT FROM visible_reader_scopes WHERE topic=$3)
