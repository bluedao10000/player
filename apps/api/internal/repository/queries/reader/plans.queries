-- name: LockReader
SELECT id FROM reader_identities WHERE id=$1 FOR UPDATE

-- name: SetReaderPlan
UPDATE reader_identities SET plan=$2,plan_until=$3 WHERE id=$1 AND (plan,plan_until) IS DISTINCT FROM ($2::text,$3::timestamptz)

-- name: RecordPlanChange
INSERT INTO reader_plan_changes(reader_id,plan,valid_until,operator) VALUES($1,$2,$3,$4)
