-- name: CreateRate
INSERT INTO billing_rates(kind,endpoint,provider_account,model,currency,effective_at,unit,unit_micros,input_micros,output_micros,cached_micros,cap_micros,created_by)
  VALUES($1,$2,$3,$4,$5,$6,$7,coalesce($8,0::bigint),coalesce($9,0::bigint),coalesce($10,0::bigint),$11,$12,$13) RETURNING jsonb_build_object('id',id,'kind',kind,'effective_at',effective_at)

-- name: ListRates
SELECT coalesce(jsonb_agg(to_jsonb(x) ORDER BY effective_at DESC,id),'[]') FROM
 (SELECT * FROM billing_rates WHERE ($1='' OR kind=$1) AND ($2='' OR currency=$2) ORDER BY effective_at DESC,id LIMIT 100)x

-- name: DailyStatements
SELECT coalesce(jsonb_agg(to_jsonb(s) ORDER BY id),'[]') FROM billing_statements s WHERE day=$1 AND currency=$2

-- name: DailyReceipts
SELECT coalesce(jsonb_agg(to_jsonb(x) ORDER BY call_id),'[]') FROM
 (SELECT * FROM billing_daily_costs($1,$2) WHERE ($3='' OR call_id>nullif($3,'')::uuid)
 AND ($4='' OR provider_account=$4) AND ($5='' OR model=$5) ORDER BY call_id LIMIT 100)x
