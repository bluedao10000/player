-- name: ProductionUsage
WITH worlds AS (
  SELECT w.slug,w.name,w.edition,m.loaded_at
  FROM work_worlds w JOIN episode_plan_manifests m ON m.world_slug=w.slug
  ORDER BY m.loaded_at DESC LIMIT $1
), runs AS (
  SELECT p.world_slug,p.number,r.* FROM worlds w JOIN episode_plans p ON p.world_slug=w.slug
  JOIN research_runs r ON r.topic=p.topic
), steps AS (
  SELECT a.world_slug,nullif((a.spec->>'episode')::int,0) AS number,s.* FROM worlds w JOIN episode_art_jobs a ON a.world_slug=w.slug
  JOIN media_candidates c ON c.art_job=a.id JOIN media_steps s ON s.slot=c.slot
), subjects AS (
  SELECT world_slug,number,'research:'||id AS subject FROM runs
  UNION ALL
  SELECT world_slug,number,'media:'||slot||':r'||round||':'||step||':a'||attempt FROM steps
), usage AS (
  SELECT world_slug,number,purpose,operation,requested_model AS model,
    count(*) AS calls,count(*) FILTER (WHERE outcome IN ('http_error','provider_error')) AS errors,
    count(*) FILTER (WHERE meter_state<>'measured') AS unmetered,
    sum(total_tokens) FILTER (WHERE meter_state='measured') AS tokens,sum(images) AS images,
    round(sum(extract(epoch FROM finished_at-started_at)),1) AS seconds
  FROM subjects JOIN model_usage_receipts USING(subject)
  WHERE receipt_rank=1 GROUP BY 1,2,3,4,5
), episodes AS (
  SELECT p.world_slug,p.number,nullif(p.spec->>'sourceNumber','')::int AS source_number,
    (SELECT min(started_at) FROM runs r WHERE r.topic=p.topic) AS started_at,
    (SELECT checked_at FROM visible_reader_scopes a WHERE a.topic=p.topic) AS published_at,
    (SELECT count(*) FROM runs r WHERE r.topic=p.topic AND r.stage='failed') AS failed_research
  FROM worlds w JOIN episode_plans p ON p.world_slug=w.slug
), progress AS (
  SELECT w.slug AS world,w.name AS title,w.edition,w.loaded_at AS registered_at,
    (SELECT min(started_at) FROM runs WHERE world_slug=w.slug) AS started_at,
    (SELECT max(checked_at) FROM visible_reader_scopes WHERE world_slug=w.slug) AS published_at,
    (SELECT max(finished_at) FROM steps WHERE world_slug=w.slug) AS last_media_at,
    (SELECT count(*) FROM runs WHERE world_slug=w.slug AND stage='failed') AS failed_research,
    coalesce((SELECT jsonb_agg(to_jsonb(e)-'world_slug' ORDER BY number) FROM episodes e WHERE world_slug=w.slug),'[]') AS episodes,
    coalesce((SELECT jsonb_agg(to_jsonb(u)-'world_slug' ORDER BY number,purpose,operation,model) FROM usage u WHERE world_slug=w.slug),'[]') AS operations
  FROM worlds w
)
SELECT coalesce(jsonb_agg(to_jsonb(p) ORDER BY registered_at DESC),'[]') FROM progress p
