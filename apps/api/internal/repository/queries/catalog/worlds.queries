-- name: ScopeAcceptances
SELECT coalesce(jsonb_agg(jsonb_build_object('id',a.id,'world',a.edition_slug,'edition_title',w.name||' · '||w.edition,'first',a.scope_first,'last',a.scope_last,
			'version',a.v,'rule',a.rule,'checked_at',a.checked_at,'published',p.id IS NOT NULL,'passed',a.passed,'checks',CASE WHEN jsonb_typeof(a.checks)='array' THEN a.checks ELSE '[]'::jsonb END,'picks',a.picks,
            'previous_gaps',(SELECT jsonb_build_object('id',b.id,'items',(SELECT coalesce(jsonb_agg((c->>'name')||' · '||(i->>'label')||'：'||(i->>'gap') ORDER BY dim,seq),'[]'::jsonb)
              FROM jsonb_array_elements(CASE WHEN jsonb_typeof(b.checks)='array' THEN b.checks ELSE '[]'::jsonb END) WITH ORDINALITY dims(c,dim)
              CROSS JOIN jsonb_array_elements(CASE WHEN jsonb_typeof(c->'items')='array' THEN c->'items' ELSE '[]'::jsonb END) WITH ORDINALITY items(i,seq) WHERE i ? 'gap'))
              FROM scope_acceptances b WHERE b.topic=a.topic AND b.v=a.v AND b.rule=a.rule AND b.id<a.id AND NOT b.passed ORDER BY b.id DESC LIMIT 1)) ORDER BY h.topic),'[]')
			FROM scope_heads h JOIN scope_acceptances a ON h.latest=a.id JOIN research_topics t ON t.id=h.topic JOIN work_worlds w ON w.slug=t.world_slug LEFT JOIN visible_reader_scopes p ON p.id=a.id

-- name: Discovery
WITH chapters AS (
			SELECT v,position,card FROM published_chapters
			UNION ALL SELECT v,first_episode,chapter FROM published_extensions
		), scenes AS (
			SELECT s.v,c.position AS chapter,s.position,s.card FROM published_scenes s
			JOIN published_chapters c ON (c.v,c.slug)=(s.v,s.chapter)
			UNION ALL SELECT v,first_episode,0,scene FROM published_extensions
		), people AS (
			SELECT v,0 AS source,position,slug,card FROM published_characters
			UNION ALL SELECT v,1,0,slug,card FROM extension_people
		)
		SELECT jsonb_build_object('items',coalesce(jsonb_agg(w.card || jsonb_build_object(
			'chapters',coalesce(ch.cards,'[]'), 'characters',coalesce(p.cards,'[]'), 'scene',s.card
		) ORDER BY h.position),'[]'))
		FROM home_world_slots h JOIN published_worlds w USING(work_id)
		LEFT JOIN (SELECT DISTINCT ON (v) v,card FROM scenes ORDER BY v,chapter,position,card->>'slug') s ON s.v=w.version_id
		LEFT JOIN (SELECT v,jsonb_agg(card ORDER BY position,card->>'slug') cards FROM chapters GROUP BY v) ch ON ch.v=w.version_id
		LEFT JOIN (SELECT v,jsonb_agg(card ORDER BY source,position,slug) cards FROM people GROUP BY v) p ON p.v=w.version_id

-- name: HomeWorlds
SELECT jsonb_build_object('items',coalesce(jsonb_agg(w.card || jsonb_build_object('scene_previews',coalesce((SELECT jsonb_agg(x.card ORDER BY x.slug) FROM (SELECT s.card,s.slug FROM published_scenes s WHERE s.v=w.version_id ORDER BY s.slug LIMIT 4)x),'[]')) ORDER BY h.position),'[]'))
    FROM home_world_slots h JOIN published_worlds w USING(work_id)

-- name: World
SELECT editor_public_profile(p,$1,'world/setting') FROM editor_raw_overview($1) p WHERE p IS NOT NULL

-- name: Character
SELECT editor_public_profile(p,$1,'person/'||$2) FROM editor_raw_person($1,$2) p WHERE p IS NOT NULL

-- name: Chapter
SELECT editor_public_page(p,$1) FROM editor_raw_chapter($1,$2) p WHERE p IS NOT NULL

-- name: Scene
SELECT editor_public_page(p,$1) FROM editor_raw_scene($1,$2) p WHERE p IS NOT NULL
