-- name: TopologyWorldExists
SELECT EXISTS(SELECT FROM work_worlds WHERE slug=$1)

-- name: Topology
WITH clock AS (
 SELECT coalesce($4::timestamptz,statement_timestamp()) AS as_of,
        $1::text AS window_name,
        $2::int AS window_hours,
        nullif($3::text,'') AS world_slug,
        coalesce($4::timestamptz,statement_timestamp())-make_interval(hours=>$2::int) AS window_start
), target AS (
 SELECT w.slug,w.work_id,w.name,w.edition FROM work_worlds w CROSS JOIN clock c WHERE w.slug=c.world_slug
), runs AS MATERIALIZED (
 SELECT r.stage,r.world_slug,r.status,r.outcome,r.started_at,r.finished_at
 FROM ops_task_runs r CROSS JOIN clock c
 WHERE c.world_slug IS NULL
    OR r.world_slug=c.world_slug
    OR (r.world_slug IS NULL AND r.stage IN ('source_sync','quality_scan','backup'))
), items AS MATERIALIZED (
 SELECT w.stage,w.world_slug,w.state
 FROM ops_work_items w CROSS JOIN clock c
 WHERE c.world_slug IS NULL OR w.world_slug=c.world_slug
    OR (w.world_slug IS NULL AND w.stage IN ('source_sync','quality_scan','backup'))
), current_runs AS (
 SELECT stage,count(*) FILTER(WHERE status='running')::int AS running
 FROM runs WHERE status='running' GROUP BY stage
), current_items AS (
 SELECT stage,
        count(*) FILTER(WHERE state='pending')::int AS pending,
        count(*) FILTER(WHERE state='blocked')::int AS blocked,
        count(*) FILTER(WHERE state='waiting_human')::int AS waiting_human
 FROM items GROUP BY stage
), window_runs AS (
 SELECT r.*,extract(epoch FROM r.finished_at-r.started_at)::double precision AS duration_seconds
 FROM runs r CROSS JOIN clock c
 WHERE r.status IN ('success','failed','skipped')
   AND r.finished_at>=c.window_start AND r.finished_at<c.as_of
), window_counts AS (
 SELECT stage,
  count(*) FILTER(WHERE status='success')::int AS success,
  count(*) FILTER(WHERE status='failed')::int AS failed,
  count(*) FILTER(WHERE status='skipped')::int AS skipped,
  count(*)::int AS completed
 FROM window_runs GROUP BY stage
), durations AS (
 SELECT stage,count(*)::int AS sample_count,
  avg(duration_seconds) AS average,
  percentile_cont(0.5) WITHIN GROUP(ORDER BY duration_seconds) AS median,
  percentile_cont(0.9) WITHIN GROUP(ORDER BY duration_seconds) AS p90
 FROM window_runs
 WHERE duration_seconds>=0
 GROUP BY stage
), outcomes AS (
 SELECT stage,jsonb_object_agg(outcome,total ORDER BY outcome) AS distribution
 FROM (
  SELECT stage,outcome,count(*)::int AS total
  FROM window_runs WHERE outcome IS NOT NULL GROUP BY stage,outcome
 ) grouped GROUP BY stage
), latest AS (
 SELECT stage,max(coalesce(finished_at,started_at)) AS recent_execution_at
 FROM runs GROUP BY stage
), heartbeat_state AS (
 SELECT h.*,
  CASE WHEN h.last_ok_at IS NULL OR h.last_ok_at<c.as_of-GREATEST(h.expected_seconds*3,120)*interval '1 second'
       THEN 'offline'
       WHEN h.consecutive_errors>=3 THEN 'online_error' ELSE 'online' END AS worker_state
 FROM ops_worker_heartbeats h CROSS JOIN clock c
), worker_counts AS (
 SELECT m.stage_id,
  count(DISTINCT h.worker_id) FILTER(WHERE h.worker_state IN ('online','online_error'))::int AS online_workers,
  count(DISTINCT h.worker_id) FILTER(WHERE h.worker_state='online_error')::int AS workers_with_error,
  max(h.last_tick_at) AS last_heartbeat_at
 FROM ops_stage_worker_loops m
 LEFT JOIN heartbeat_state h ON (h.role,h.loop)=(m.role,m.loop)
 GROUP BY m.stage_id
), stage_execution_keys AS (
 SELECT id AS stage_id,
  CASE id
   WHEN 'plan' THEN 'planning'
   WHEN 'configuration' THEN 'configuration_detail'
   WHEN 'research' THEN 'research'
   WHEN 'editorial' THEN 'editorial'
   WHEN 'media_reference' THEN 'media_reference'
   WHEN 'media_generate' THEN 'media_generate'
   WHEN 'media_review' THEN 'media_review'
   WHEN 'media_rework' THEN 'media_rework'
   ELSE NULL
  END AS execution_key,
  CASE WHEN id IN ('plan','configuration') THEN 'configuration'
       WHEN id IN ('media_reference','media_generate','media_review','media_rework') THEN 'media'
       ELSE NULL END AS legacy_key
 FROM ops_stages
), agent_counts AS (
 SELECT m.stage_id,
  count(*) FILTER(WHERE h.worker_state IN ('online','online_error'))::int AS online_agents,
  count(*) FILTER(WHERE h.worker_state IN ('online','online_error')
       AND coalesce((h.executions ? k.execution_key),false))::int AS agents_with_detail,
  count(*) FILTER(WHERE h.worker_state IN ('online','online_error')
       AND NOT coalesce((h.executions ? k.execution_key),false)
       AND coalesce((h.executions->>k.legacy_key)::int,0)>0)::int AS legacy_agents_with_work,
  coalesce(sum(coalesce((h.executions->>k.execution_key)::int,0))
       FILTER(WHERE h.worker_state IN ('online','online_error')),0)::int AS known_executions,
  CASE WHEN m.stage_id IN ('plan','media_reference')
       THEN coalesce(sum(coalesce((h.executions->>k.legacy_key)::int,0))
         FILTER(WHERE h.worker_state IN ('online','online_error')
           AND NOT coalesce((h.executions ? k.execution_key),false)),0)::int
       ELSE 0 END AS legacy_unclassified
 FROM ops_stage_worker_loops m
 JOIN stage_execution_keys k ON k.stage_id=m.stage_id AND k.execution_key IS NOT NULL
 LEFT JOIN heartbeat_state h ON (h.role,h.loop)=(m.role,m.loop) AND m.role='agent'
 GROUP BY m.stage_id
), record_keys AS (
 SELECT stage,world_slug FROM runs
 UNION
 SELECT stage,world_slug FROM items
), stage_payloads AS (
 SELECT s.id,s.title,s.eyebrow,s.grp,s.topology_group,s.position,s.upstream,s.tracked,
  s.id IN ('source_sync','quality_scan','backup') AS global_scope,
  CASE WHEN c.world_slug IS NULL THEN NULL ELSE EXISTS(
   SELECT FROM record_keys r WHERE r.stage=s.id AND r.world_slug IS NOT DISTINCT FROM
     CASE WHEN s.id IN ('source_sync','quality_scan','backup') THEN NULL ELSE c.world_slug END
  ) END AS has_records,
  coalesce(cr.running,0)+coalesce(ci.pending,0)+coalesce(ci.blocked,0)+coalesce(ci.waiting_human,0) AS current_total,
  coalesce(cr.running,0) AS running,
  coalesce(ci.pending,0) AS pending,
  coalesce(ci.blocked,0) AS blocked,
  coalesce(ci.waiting_human,0) AS waiting_human,
  wc.success,wc.failed,wc.skipped,wc.completed,
  CASE WHEN coalesce(wc.success,0)+coalesce(wc.failed,0)=0 THEN NULL
       ELSE wc.success::numeric/(wc.success+wc.failed) END AS success_rate,
  coalesce(d.sample_count,0) AS duration_sample_count,d.average,d.median,d.p90,
  coalesce(wc.completed,0)::numeric/c.window_hours AS throughput_per_hour,
  CASE WHEN coalesce(wc.completed,0)<5 THEN 'low' ELSE 'sufficient' END AS sample_quality,
  coalesce(o.distribution,'{}'::jsonb) AS outcome_distribution,
  l.recent_execution_at,
  EXISTS(SELECT FROM ops_stage_worker_loops m WHERE m.stage_id=s.id) AS worker_mapped,
  coalesce(w.online_workers,0) AS online_workers,
  coalesce(w.workers_with_error,0) AS workers_with_error,
  w.last_heartbeat_at,
  EXISTS(SELECT FROM ops_stage_worker_loops m WHERE m.stage_id=s.id AND m.role='agent' AND m.loop='agent') AS agent_mapped,
  coalesce(a.known_executions,0) AS known_executions,
  coalesce(a.legacy_agents_with_work,0) AS legacy_agents_with_work,
  coalesce(a.legacy_unclassified,0) AS legacy_unclassified
 FROM ops_stages s CROSS JOIN clock c
 LEFT JOIN current_runs cr ON cr.stage=s.id
 LEFT JOIN current_items ci ON ci.stage=s.id
 LEFT JOIN window_counts wc ON wc.stage=s.id
 LEFT JOIN durations d ON d.stage=s.id
 LEFT JOIN outcomes o ON o.stage=s.id
 LEFT JOIN latest l ON l.stage=s.id
 LEFT JOIN worker_counts w ON w.stage_id=s.id
 LEFT JOIN agent_counts a ON a.stage_id=s.id
), stage_json AS (
 SELECT p.*,
  CASE WHEN NOT p.tracked THEN NULL ELSE jsonb_build_object(
   'total',p.current_total,'running',p.running,'pending',p.pending,'blocked',p.blocked,'waiting_human',p.waiting_human
  ) END AS current_json,
  CASE WHEN NOT p.tracked THEN NULL ELSE jsonb_build_object(
   'success',coalesce(p.success,0),'failed',coalesce(p.failed,0),'skipped',coalesce(p.skipped,0),
   'completed',coalesce(p.completed,0),'success_rate',p.success_rate,
   'outcome_distribution',p.outcome_distribution,
   'duration',jsonb_build_object('sample_count',p.duration_sample_count,'average_seconds',p.average,'median_seconds',p.median,'p90_seconds',p.p90),
   'duration_primary','median','throughput_per_hour',p.throughput_per_hour,'sample_quality',p.sample_quality,
   'recent_execution_at',p.recent_execution_at
  ) END AS window_json,
  CASE WHEN NOT p.tracked THEN NULL ELSE jsonb_build_object(
   'mapped',p.worker_mapped,
   'online_workers',CASE WHEN p.worker_mapped THEN p.online_workers ELSE NULL END,
   'workers_with_error',CASE WHEN p.worker_mapped THEN p.workers_with_error ELSE NULL END,
   'freshness',CASE WHEN NOT p.worker_mapped THEN NULL WHEN p.online_workers>0 THEN 'online' ELSE 'offline' END,
   'last_heartbeat_at',p.last_heartbeat_at,
   'worker_label',CASE WHEN NOT p.worker_mapped THEN '无对应工作进程' END,
   'running_executions',CASE WHEN NOT p.agent_mapped THEN NULL
       WHEN p.legacy_agents_with_work>0 THEN NULL ELSE p.known_executions END,
   'execution_coverage',CASE WHEN NOT p.agent_mapped THEN 'not_applicable'
       WHEN p.legacy_agents_with_work>0 THEN 'legacy_aggregate' ELSE 'stage_specific' END,
   'legacy_unclassified',p.legacy_unclassified
  ) END AS agents_json
 FROM stage_payloads p
), group_defs(id,label,eyebrow,position) AS (
 VALUES
 ('data_acquisition','数据采集','DATA ACQUISITION',1),
 ('knowledge_processing','知识处理','KNOWLEDGE PROCESSING',2),
 ('research_planning','研究与规划','RESEARCH & PLANNING',3),
 ('content_production','内容制作','CONTENT PRODUCTION',4),
 ('quality_release','质量与发布','QUALITY & RELEASE',5)
), progress_scope AS (
 SELECT DISTINCT ww.work_id,n.episode
 FROM episode_policies pol
 JOIN work_worlds ww ON ww.slug=pol.world_slug
 JOIN target tw ON tw.work_id=ww.work_id
 CROSS JOIN LATERAL generate_series(pol.first_episode,pol.last_episode) AS n(episode)
), progress_facts AS (
 SELECT ps.work_id,ps.episode,
  EXISTS(SELECT FROM episode_plans p JOIN work_worlds w ON w.slug=p.world_slug
         WHERE w.work_id=ps.work_id AND p.number=ps.episode) AS has_plan,
  EXISTS(SELECT FROM episode_plans p JOIN work_worlds w ON w.slug=p.world_slug
         JOIN reader_release_attempts r ON r.topic=p.topic
         WHERE w.work_id=ps.work_id AND p.number=ps.episode
           AND r.target_id IS NOT NULL AND r.href IS NOT NULL AND r.error IS NULL) AS is_published,
  EXISTS(SELECT FROM episode_plans p JOIN work_worlds w ON w.slug=p.world_slug
         JOIN scope_heads h ON h.topic=p.topic
         JOIN scope_acceptances a ON a.topic=h.topic AND a.id=h.latest
         WHERE w.work_id=ps.work_id AND p.number=ps.episode AND a.passed
           AND ps.episode BETWEEN a.scope_first AND a.scope_last) AS is_accepted,
  EXISTS(SELECT FROM episode_plans p JOIN work_worlds w ON w.slug=p.world_slug
         JOIN episode_admissions a ON a.topic=p.topic
         WHERE w.work_id=ps.work_id AND p.number=ps.episode) AS is_in_production,
  EXISTS(SELECT FROM episode_configuration_attempts a
         JOIN episode_production_requests r ON r.id=a.request_id
         JOIN work_worlds w ON w.slug=r.world
         WHERE w.work_id=ps.work_id AND a.number=ps.episode AND a.registered) AS is_planned
 FROM progress_scope ps
), progress AS (
 SELECT CASE WHEN NOT has_plan THEN 'unregistered'
             WHEN is_published THEN 'published'
             WHEN is_accepted THEN 'accepted'
             WHEN is_in_production THEN 'in_production'
             WHEN is_planned THEN 'planned'
             ELSE 'registered' END AS state
 FROM progress_facts
)
SELECT jsonb_build_object(
 'as_of',c.as_of,'timezone','Asia/Shanghai','window',c.window_name,
 'window_start',c.window_start,'window_end',c.as_of,'definition',1,
 'selected_world',CASE WHEN c.world_slug IS NULL THEN NULL ELSE (
  SELECT jsonb_build_object(
   'slug',t.slug,'title',t.name,'edition',t.edition,'work_id',t.work_id,
   'has_records',EXISTS(SELECT FROM record_keys r WHERE r.world_slug=t.slug),
   'progress',jsonb_build_object(
    'scope_total',(SELECT count(*)::int FROM progress),
    'unregistered',(SELECT count(*)::int FROM progress WHERE state='unregistered'),
    'registered',(SELECT count(*)::int FROM progress WHERE state='registered'),
    'planned',(SELECT count(*)::int FROM progress WHERE state='planned'),
    'in_production',(SELECT count(*)::int FROM progress WHERE state='in_production'),
    'accepted',(SELECT count(*)::int FROM progress WHERE state='accepted'),
    'published',(SELECT count(*)::int FROM progress WHERE state='published')
   )
  ) FROM target t
 ) END,
 'groups',(
  SELECT coalesce(jsonb_agg(jsonb_build_object(
    'id',g.id,'label',g.label,'eyebrow',g.eyebrow,'position',g.position,
    'stages',coalesce((SELECT jsonb_agg(jsonb_build_object(
      'id',s.id,'title',s.title,'description',s.eyebrow,'grp',s.grp,
      'topology_group',s.topology_group,'position',s.position,'upstream',s.upstream,
      'tracked',s.tracked,'global_scope',s.global_scope,'has_records',s.has_records,
      'bottleneck',s.tracked AND (coalesce(s.blocked,0)+coalesce(s.waiting_human,0)>0),
      'current',s.current_json,'window_stats',s.window_json,'agents',s.agents_json
    ) ORDER BY s.position,s.id) FROM stage_json s WHERE s.topology_group=g.id),'[]'::jsonb)
  ) ORDER BY g.position),'[]'::jsonb)
  FROM group_defs g
 ),
 'infrastructure',(
  SELECT jsonb_build_object(
   'id','infrastructure','label','基础设施','eyebrow','INFRASTRUCTURE',
   'stages',coalesce(jsonb_agg(jsonb_build_object(
      'id',s.id,'title',s.title,'description',s.eyebrow,'grp',s.grp,
      'topology_group',s.topology_group,'position',s.position,'upstream',s.upstream,
      'tracked',s.tracked,'global_scope',s.global_scope,'has_records',s.has_records,
      'bottleneck',s.tracked AND (coalesce(s.blocked,0)+coalesce(s.waiting_human,0)>0),
      'current',s.current_json,'window_stats',s.window_json,'agents',s.agents_json
   ) ORDER BY s.position,s.id) FILTER(WHERE s.id IS NOT NULL),'[]'::jsonb)
  )
  FROM stage_json s WHERE s.topology_group IS NULL
 )
)
FROM clock c

-- name: TopologyStageDetail
WITH clock AS (
 SELECT statement_timestamp() AS as_of,$2::int AS window_hours,nullif($3::text,'') AS world_slug
), worker_rows AS (
 SELECT m.role,m.loop,h.worker_id,h.node,h.version,h.last_tick_at,h.last_ok_at,h.last_error,h.consecutive_errors,
  CASE WHEN h.last_ok_at IS NULL OR h.last_ok_at<c.as_of-GREATEST(h.expected_seconds*3,120)*interval '1 second'
       THEN 'offline' WHEN h.consecutive_errors>=3 THEN 'online_error' ELSE 'online' END AS state
 FROM ops_stage_worker_loops m CROSS JOIN clock c
 LEFT JOIN ops_worker_heartbeats h ON (h.role,h.loop)=(m.role,m.loop)
 WHERE m.stage_id=$1
), queue_rows AS (
 SELECT w.*,coalesce(w.since,'-infinity'::timestamptz) AS order_at
 FROM ops_work_items w CROSS JOIN clock c
 WHERE w.stage=$1 AND (c.world_slug IS NULL OR w.world_slug=c.world_slug
   OR (w.world_slug IS NULL AND $1 IN ('source_sync','quality_scan','backup')))
   AND ($4::timestamptz IS NULL OR
     (coalesce(w.since,'-infinity'::timestamptz),w.item_key)<($4::timestamptz,$5::text))
 ORDER BY order_at DESC,w.item_key DESC LIMIT $8::int
), run_rows AS (
 SELECT r.*,coalesce(r.finished_at,r.started_at) AS order_at,
        CASE WHEN r.finished_at>=r.started_at THEN extract(epoch FROM r.finished_at-r.started_at)::double precision END AS duration_seconds
 FROM ops_task_runs r CROSS JOIN clock c
 WHERE r.stage=$1 AND (c.world_slug IS NULL OR r.world_slug=c.world_slug
   OR (r.world_slug IS NULL AND $1 IN ('source_sync','quality_scan','backup')))
   AND ($6::timestamptz IS NULL OR
     (coalesce(r.finished_at,r.started_at),r.run_key)<($6::timestamptz,$7::text))
 ORDER BY order_at DESC,r.run_key DESC LIMIT $8::int
), failure_reasons AS (
 SELECT r.error,count(*)::int AS count
 FROM ops_task_runs r CROSS JOIN clock c
 WHERE r.stage=$1 AND r.status='failed' AND r.finished_at>=c.as_of-make_interval(hours=>$2::int)
   AND r.finished_at<c.as_of AND r.error IS NOT NULL
   AND (c.world_slug IS NULL OR r.world_slug=c.world_slug
     OR (r.world_slug IS NULL AND $1 IN ('source_sync','quality_scan','backup')))
 GROUP BY r.error ORDER BY count DESC,r.error LIMIT 20
)
SELECT jsonb_build_object(
 'as_of',c.as_of,
 'workers',coalesce((SELECT jsonb_agg(jsonb_build_object(
  'role',role,'loop',loop,'worker_id',worker_id,'node',node,'version',version,'state',state,
  'last_error',last_error,'last_seen',last_tick_at) ORDER BY role,loop,worker_id) FROM worker_rows),'[]'::jsonb),
 'current_queue',coalesce((SELECT jsonb_agg(
   (to_jsonb(q)-'order_at')||jsonb_build_object('link',jsonb_build_object('page','operations','params',jsonb_strip_nulls(jsonb_build_object(
    'stage',q.stage,'world',q.world_slug,'episode',q.episode,'item_key',q.item_key))))
   ORDER BY q.order_at DESC,q.item_key DESC) FROM queue_rows q),'[]'::jsonb),
 'recent_runs',coalesce((SELECT jsonb_agg(
   (to_jsonb(r)-'order_at')||jsonb_build_object('link',jsonb_build_object('page','operations','params',jsonb_strip_nulls(jsonb_build_object(
    'stage',r.stage,'world',r.world_slug,'run_key',r.run_key,'source_table',r.source_table,'source_id',r.source_id,
    'episode',r.episode_first))))
   ORDER BY r.order_at DESC,r.run_key DESC) FROM run_rows r),'[]'::jsonb),
 'failure_reasons',coalesce((SELECT jsonb_agg(jsonb_build_object('reason',error,'count',count) ORDER BY count DESC,error) FROM failure_reasons),'[]'::jsonb)
) FROM clock c
