-- name: Versions
SELECT coalesce(jsonb_agg(to_jsonb(x) ORDER BY id DESC),'[]') FROM (SELECT v.id,s.name,v.version,v.checksum,v.snapshot_key IS NOT NULL AS archived FROM knowledge_source_versions v JOIN knowledge_sources s ON s.id=v.source_id WHERE s.name=$1)x

-- name: Matches
SELECT coalesce(jsonb_agg(to_jsonb(x)),'[]') FROM (SELECT * FROM knowledge_match_candidates ORDER BY id LIMIT $1)x

-- name: Match
SELECT to_jsonb(k)||jsonb_build_object('incoming',r.raw,'candidate_records',(SELECT jsonb_agg(jsonb_build_object('id',x.id,'raw',x.raw,'diff',(SELECT coalesce(jsonb_object_agg(key,jsonb_build_array(r.raw->key,x.raw->key)),'{}') FROM jsonb_object_keys(r.raw||x.raw) key WHERE r.raw->key IS DISTINCT FROM x.raw->key))) FROM knowledge_source_records x WHERE x.active AND x.work_id=k.candidate_work_id)) FROM knowledge_match_candidates k JOIN knowledge_source_records r ON r.id=k.source_record_id WHERE k.id=$1

-- name: Issues
SELECT jsonb_build_object('score',(SELECT to_jsonb(s) FROM knowledge_quality_scores s WHERE work_id=$1),'issues',coalesce((SELECT jsonb_agg(to_jsonb(i)) FROM knowledge_quality_issues i WHERE entity_id=$1),'[]'))

-- name: History
SELECT coalesce(jsonb_agg(to_jsonb(a) ORDER BY id DESC),'[]') FROM knowledge_curation_actions a WHERE work_id=$1 OR after_value->>'work_id'=$1::uuid::text

-- name: Assessments
SELECT coalesce(jsonb_agg(to_jsonb(a)||jsonb_build_object('current_evidence',a.evidence=e.doc) ORDER BY a.id DESC),'[]') FROM knowledge_ai_match_assessments a LEFT JOIN (SELECT id,jsonb_build_object('reason',reason,'incoming',incoming,'candidates',candidates) doc FROM knowledge_match_evidence) e ON e.id=a.candidate_id WHERE a.candidate_id=$1
