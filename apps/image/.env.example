IMAGE_PORT=14680
# Generate each separately with openssl rand -hex 32.
IMAGE_API_TOKEN=
IMAGE_SIGNING_KEY_HEX=
# Alternatively mount secrets and set the in-container paths.
# IMAGE_API_TOKEN_FILE=/run/secrets/image-api
# IMAGE_SIGNING_KEY_FILE=/run/secrets/image-signing

IMAGE_MAX_UPLOAD_BYTES=26214400
IMAGE_MAX_PIXELS=32000000
IMAGE_CACHE_BYTES=2147483648
IMAGE_TRANSFORM_CONCURRENCY=2
IMAGE_VIPS_THREADS=1
IMAGE_UPLOAD_CONCURRENCY=4
IMAGE_API_RPS=30
IMAGE_TRANSFORM_RPS=20
IMAGE_AI_WORKERS=1
RUST_LOG=folio_image=info

# OpenAI or an OpenAI-compatible gateway, using the same variables as apps/agent.
MEDIA_AI_BASE_URL=https://api.openai.com/v1
MEDIA_AI_MODEL=gpt-image-2
MEDIA_AI_API_KEY=
VISION_AI_BASE_URL=https://api.openai.com/v1
VISION_AI_MODEL=gpt-4.1-mini
VISION_AI_API_KEY=
# MEDIA_AI_MODE=magpie
# MAGPIE_BASE_URL=https://gateway.example/v1
# MAGPIE_IMAGE_MODEL=codex/gpt-image-2
# MAGPIE_API_KEY=

# Gemini uses Google's endpoint. Choose models enabled for the account.
GEMINI_API_KEY=
GEMINI_VISION_MODEL=
GEMINI_IMAGE_MODEL=
