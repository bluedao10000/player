[Unit]
Description=Dispatch at most five Guangzhou episode requests
After=docker.service
Wants=docker.service

[Service]
Type=oneshot
User=root
StandardInput=file:/srv/folio-data/dispatch-aired-episodes.sql
ExecStart=/usr/bin/docker exec -i folio-postgres psql -X -v ON_ERROR_STOP=1 -U postgres -d folio
EnvironmentFile=/srv/folio-data/database.env
TimeoutStartSec=27min
ExecStartPost=/usr/bin/python3 /srv/folio-data/recover-episodes.py
